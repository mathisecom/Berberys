{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign heading_color = section.settings.heading_color
  assign badge_bg = section.settings.badge_bg
  assign badge_text_color = section.settings.badge_text_color
  assign btn_bg = section.settings.btn_bg
  assign btn_text_color = section.settings.btn_text_color
  assign btn_hover_bg = section.settings.btn_hover_bg
  assign stars_color = section.settings.stars_color
  assign trust_text_color = section.settings.trust_text_color
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign heading_font_bold = heading_font | font_modify: 'weight', 'bolder'
  assign body_font_bold = body_font | font_modify: 'weight', 'bolder'
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font_bold | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}

  .immune-hero-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: {{ section.settings.padding_top_desktop }}px {{ section.settings.padding_x_desktop }}px {{ section.settings.padding_bottom_desktop }}px;
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-style: {{ body_font.style }};
    font-weight: {{ body_font.weight }};
    overflow: hidden;
  }

  .immune-hero-{{ section_id }} * {
    box-sizing: border-box;
  }

  .immune-hero-{{ section_id }} .immune-hero__container {
    width: 100%;
    max-width: {{ section.settings.content_max_width }}px;
    margin: 0 auto;
    text-align: center;
  }

  .immune-hero-{{ section_id }} .immune-hero__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: {{ badge_bg }};
    color: {{ badge_text_color }};
    padding: {{ section.settings.badge_padding_y }}px {{ section.settings.badge_padding_x }}px;
    border-radius: {{ section.settings.badge_radius }}px;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-size: {{ section.settings.badge_size_desktop }}px;
    font-weight: {{ section.settings.badge_weight }};
    line-height: 1;
    margin-bottom: {{ section.settings.badge_margin_bottom }}px;
  }

  .immune-hero-{{ section_id }} .immune-hero__offer {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: {{ section.settings.offer_gap }}px;
    margin: 0 0 {{ section.settings.offer_margin_bottom }}px;
    color: {{ heading_color }};
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    line-height: 1;
    letter-spacing: -0.04em;
  }

  .immune-hero-{{ section_id }} .immune-hero__offer-prefix {
    font-size: {{ section.settings.prefix_size_desktop }}px;
    font-weight: {{ section.settings.prefix_weight }};
    letter-spacing: -0.03em;
  }

  .immune-hero-{{ section_id }} .immune-hero__offer-value {
    font-size: {{ section.settings.discount_size_desktop }}px;
    font-weight: {{ section.settings.discount_weight }};
    letter-spacing: -0.06em;
  }

  .immune-hero-{{ section_id }} .immune-hero__description {
    max-width: {{ section.settings.description_max_width }}px;
    margin: 0 auto {{ section.settings.description_margin_bottom }}px;
    color: {{ text_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-size: {{ section.settings.body_size_desktop }}px;
    line-height: 1.45;
    font-weight: {{ section.settings.body_weight }};
  }

  .immune-hero-{{ section_id }} .immune-hero__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    max-width: {{ section.settings.button_max_width }}px;
    margin: 0 auto {{ section.settings.button_margin_bottom }}px;
    background-color: {{ btn_bg }};
    color: {{ btn_text_color }};
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    border-radius: {{ section.settings.button_radius }}px;
    text-decoration: none;
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-weight: {{ section.settings.button_weight }};
    font-size: {{ section.settings.button_size_desktop }}px;
    line-height: 1;
    text-align: center;
    text-transform: uppercase;
    transition: all 0.25s ease;
  }

  .immune-hero-{{ section_id }} .immune-hero__btn:hover {
    background-color: {{ btn_hover_bg }};
    transform: translateY(-1px);
  }

  .immune-hero-{{ section_id }} .immune-hero__trust {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: {{ section.settings.trust_gap }}px;
    color: {{ trust_text_color }};
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-size: {{ section.settings.trust_size_desktop }}px;
    line-height: 1.2;
  }

  .immune-hero-{{ section_id }} .immune-hero__stars {
    color: {{ stars_color }};
    font-size: {{ section.settings.stars_size_desktop }}px;
    letter-spacing: {{ section.settings.stars_letter_spacing }}px;
    line-height: 1;
  }

  .immune-hero-{{ section_id }} .immune-hero__trust-brand {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-weight: 700;
  }

  .immune-hero-{{ section_id }} .immune-hero__trust-star {
    color: {{ stars_color }};
    font-size: {{ section.settings.trust_icon_size }}px;
    line-height: 1;
  }

  @media (max-width: 749px) {
    .immune-hero-{{ section_id }} {
      padding: {{ section.settings.padding_top_mobile }}px {{ section.settings.padding_x_mobile }}px {{ section.settings.padding_bottom_mobile }}px;
    }

    .immune-hero-{{ section_id }} .immune-hero__container {
      max-width: 100%;
    }

    .immune-hero-{{ section_id }} .immune-hero__badge {
      font-size: {{ section.settings.badge_size_mobile }}px;
      padding: {{ section.settings.badge_padding_y_mobile }}px {{ section.settings.badge_padding_x_mobile }}px;
      margin-bottom: {{ section.settings.badge_margin_bottom_mobile }}px;
    }

    .immune-hero-{{ section_id }} .immune-hero__offer {
      gap: {{ section.settings.offer_gap_mobile }}px;
      margin-bottom: {{ section.settings.offer_margin_bottom_mobile }}px;
      flex-wrap: wrap;
    }

    .immune-hero-{{ section_id }} .immune-hero__offer-prefix {
      font-size: {{ section.settings.prefix_size_mobile }}px;
    }

    .immune-hero-{{ section_id }} .immune-hero__offer-value {
      font-size: {{ section.settings.discount_size_mobile }}px;
    }

    .immune-hero-{{ section_id }} .immune-hero__description {
      font-size: {{ section.settings.body_size_mobile }}px;
      margin-bottom: {{ section.settings.description_margin_bottom_mobile }}px;
    }

    .immune-hero-{{ section_id }} .immune-hero__btn {
      max-width: 100%;
      font-size: {{ section.settings.button_size_mobile }}px;
      padding: {{ section.settings.button_padding_y_mobile }}px {{ section.settings.button_padding_x_mobile }}px;
      margin-bottom: {{ section.settings.button_margin_bottom_mobile }}px;
    }

    .immune-hero-{{ section_id }} .immune-hero__trust {
      gap: {{ section.settings.trust_gap_mobile }}px;
      font-size: {{ section.settings.trust_size_mobile }}px;
    }

    .immune-hero-{{ section_id }} .immune-hero__stars {
      font-size: {{ section.settings.stars_size_mobile }}px;
    }
  }
</style>

<section class="immune-hero-{{ section_id }}">
  <div class="immune-hero__container">

    {%- if section.settings.badge_text != blank -%}
      <div class="immune-hero__badge">
        {{ section.settings.badge_text }}
      </div>
    {%- endif -%}

    <div class="immune-hero__offer">
      {%- if section.settings.offer_prefix != blank -%}
        <span class="immune-hero__offer-prefix">
          {{ section.settings.offer_prefix }}
        </span>
      {%- endif -%}

      {%- if section.settings.offer_value != blank -%}
        <span class="immune-hero__offer-value">
          {{ section.settings.offer_value }}
        </span>
      {%- endif -%}
    </div>

    {%- if section.settings.description != blank -%}
      <p class="immune-hero__description">
        {{ section.settings.description }}
      </p>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="immune-hero__btn">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}

    {%- if section.settings.show_trustpilot -%}
      <div class="immune-hero__trust">
        {%- if section.settings.trust_label != blank -%}
          <span>{{ section.settings.trust_label }}</span>
        {%- endif -%}

        {%- if section.settings.stars_text != blank -%}
          <span class="immune-hero__stars">{{ section.settings.stars_text }}</span>
        {%- endif -%}

        {%- if section.settings.trust_score != blank -%}
          <span>{{ section.settings.trust_score }}</span>
        {%- endif -%}

        {%- if section.settings.trust_brand != blank -%}
          <span class="immune-hero__trust-brand">
            <span class="immune-hero__trust-star">★</span>
            {{ section.settings.trust_brand }}
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "Immune Hero",
  "tag": "section",
  "class": "section-immune-hero",
  "settings": [
    {
      "type": "header",
      "content": "Contenu principal"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texte du badge",
      "default": "Naali Days"
    },
    {
      "type": "text",
      "id": "offer_prefix",
      "label": "Texte avant la remise",
      "default": "Jusqu’à"
    },
    {
      "type": "text",
      "id": "offer_value",
      "label": "Remise / valeur principale",
      "default": "-50%"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "À l’occasion du mois de la santé mentale, profitez de nos meilleures offres de l’année."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Texte du bouton",
      "default": "Découvrir les offres"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Avis Trustpilot"
    },
    {
      "type": "checkbox",
      "id": "show_trustpilot",
      "label": "Afficher la ligne d’avis",
      "default": true
    },
    {
      "type": "text",
      "id": "trust_label",
      "label": "Texte avant les étoiles",
      "default": "Excellent"
    },
    {
      "type": "text",
      "id": "stars_text",
      "label": "Étoiles",
      "default": "★★★★★"
    },
    {
      "type": "text",
      "id": "trust_score",
      "label": "Note",
      "default": "Noté 4,7/5 sur"
    },
    {
      "type": "text",
      "id": "trust_brand",
      "label": "Nom de la plateforme",
      "default": "Trustpilot"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#FEF9F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Couleur de l’offre",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Fond du badge",
      "default": "#F47F91"
    },
    {
      "type": "color",
      "id": "badge_text_color",
      "label": "Texte du badge",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Couleur du bouton",
      "default": "#FF7A0A"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Texte du bouton",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "btn_hover_bg",
      "label": "Couleur du bouton au survol",
      "default": "#E96C00"
    },
    {
      "type": "color",
      "id": "stars_color",
      "label": "Couleur des étoiles",
      "default": "#00B67A"
    },
    {
      "type": "color",
      "id": "trust_text_color",
      "label": "Couleur texte avis",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Police des titres",
      "default": "manrope_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Police du texte",
      "default": "dm_sans_n4"
    },
    {
      "type": "select",
      "id": "badge_weight",
      "label": "Épaisseur badge",
      "default": "700",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ]
    },
    {
      "type": "select",
      "id": "prefix_weight",
      "label": "Épaisseur texte avant remise",
      "default": "700",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ]
    },
    {
      "type": "select",
      "id": "discount_weight",
      "label": "Épaisseur remise",
      "default": "800",
      "options": [
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ]
    },
    {
      "type": "select",
      "id": "body_weight",
      "label": "Épaisseur description",
      "default": "500",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "select",
      "id": "button_weight",
      "label": "Épaisseur bouton",
      "default": "800",
      "options": [
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" }
      ]
    },
    {
      "type": "header",
      "content": "Tailles PC"
    },
    {
      "type": "range",
      "id": "badge_size_desktop",
      "label": "Taille badge PC",
      "min": 10,
      "max": 30,
      "step": 1,
      "default": 19
    },
    {
      "type": "range",
      "id": "prefix_size_desktop",
      "label": "Taille texte avant remise PC",
      "min": 16,
      "max": 50,
      "step": 1,
      "default": 26
    },
    {
      "type": "range",
      "id": "discount_size_desktop",
      "label": "Taille remise PC",
      "min": 40,
      "max": 120,
      "step": 1,
      "default": 78
    },
    {
      "type": "range",
      "id": "body_size_desktop",
      "label": "Taille description PC",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "button_size_desktop",
      "label": "Taille bouton PC",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 17
    },
    {
      "type": "range",
      "id": "trust_size_desktop",
      "label": "Taille avis PC",
      "min": 10,
      "max": 22,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "stars_size_desktop",
      "label": "Taille étoiles PC",
      "min": 12,
      "max": 34,
      "step": 1,
      "default": 22
    },
    {
      "type": "header",
      "content": "Tailles mobile"
    },
    {
      "type": "range",
      "id": "badge_size_mobile",
      "label": "Taille badge mobile",
      "min": 10,
      "max": 26,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "prefix_size_mobile",
      "label": "Taille texte avant remise mobile",
      "min": 16,
