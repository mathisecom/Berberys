{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign accent_color = section.settings.accent_color
  assign heading_color = section.settings.heading_color
  assign btn_bg = section.settings.btn_bg
  assign btn_text_color = section.settings.btn_text_color
  assign btn_hover_bg = section.settings.btn_hover_bg
  assign image_position = section.settings.image_position
  assign heading_size = section.settings.heading_size
  assign body_size = section.settings.body_size
  assign content_max_width = section.settings.content_max_width
  assign section_padding_top = section.settings.padding_top
  assign section_padding_bottom = section.settings.padding_bottom
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign heading_font_bold = heading_font | font_modify: 'weight', 'bolder'
  assign body_font_bold = body_font | font_modify: 'weight', 'bolder'
-%}

{{ heading_font | font_face: font_display: 'swap' }}
{{ heading_font_bold | font_face: font_display: 'swap' }}
{{ body_font | font_face: font_display: 'swap' }}
{{ body_font_bold | font_face: font_display: 'swap' }}

<style>
  .immune-hero-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: {{ section_padding_top }}px 20px {{ section_padding_bottom }}px;
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-style: {{ body_font.style }};
    font-weight: {{ body_font.weight }};
    overflow: hidden;
  }

  .immune-hero-{{ section_id }} .immune-hero__container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  {% if image_position == 'left' %}
  .immune-hero-{{ section_id }} .immune-hero__container {
    direction: rtl;
  }
  .immune-hero-{{ section_id }} .immune-hero__content,
  .immune-hero-{{ section_id }} .immune-hero__media {
    direction: ltr;
  }
  {% endif %}

  .immune-hero-{{ section_id }} .immune-hero__content {
    max-width: {{ content_max_width }}px;
  }

  .immune-hero-{{ section_id }} .immune-hero__eyebrow {
    font-size: 15px;
    color: {{ text_color }};
    margin: 0 0 10px;
    font-weight: 400;
  }

  .immune-hero-{{ section_id }} .immune-hero__stats {
    font-size: 15px;
    color: {{ text_color }};
    margin: 0 0 28px;
    font-weight: 400;
  }

  .immune-hero-{{ section_id }} .immune-hero__stats strong {
    color: {{ accent_color }};
    font-weight: 700;
  }

  .immune-hero-{{ section_id }} .immune-hero__heading {
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-size: {{ heading_size }}px;
    line-height: 1.1;
    font-weight: 800;
    color: {{ heading_color }};
    margin: 0 0 32px;
    letter-spacing: -0.02em;
  }

  .immune-hero-{{ section_id }} .immune-hero__btn {
    display: inline-block;
    background-color: {{ btn_bg }};
    color: {{ btn_text_color }};
    padding: 18px 48px;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 700;
    font-size: 16px;
    margin-bottom: 28px;
    transition: all 0.25s ease;
    border: none;
    cursor: pointer;
    text-align: center;
  }

  .immune-hero-{{ section_id }} .immune-hero__btn:hover {
    background-color: {{ btn_hover_bg }};
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(0,0,0,0.12);
  }

  .immune-hero-{{ section_id }} .immune-hero__description {
    font-size: {{ body_size }}px;
    line-height: 1.55;
    color: {{ text_color }};
    margin: 0 0 24px;
    max-width: 520px;
  }

  .immune-hero-{{ section_id }} .immune-hero__guarantee {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: {{ text_color }};
  }

  .immune-hero-{{ section_id }} .immune-hero__guarantee svg {
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .immune-hero-{{ section_id }} .immune-hero__media {
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .immune-hero-{{ section_id }} .immune-hero__media img {
    max-width: 100%;
    height: auto;
    display: block;
  }

  /* Tablet */
  @media (max-width: 990px) {
    .immune-hero-{{ section_id }} .immune-hero__container {
      gap: 40px;
    }
    .immune-hero-{{ section_id }} .immune-hero__heading {
      font-size: {{ heading_size | times: 0.8 | round }}px;
    }
  }

  /* Mobile */
  @media (max-width: 749px) {
    .immune-hero-{{ section_id }} {
      padding: {{ section_padding_top | times: 0.6 | round }}px 20px {{ section_padding_bottom | times: 0.6 | round }}px;
    }
    .immune-hero-{{ section_id }} .immune-hero__container {
      grid-template-columns: 1fr;
      gap: 24px;
      direction: ltr;
      text-align: left;
    }
    .immune-hero-{{ section_id }} .immune-hero__media {
      order: -1;
    }
    .immune-hero-{{ section_id }} .immune-hero__content {
      max-width: 100%;
    }
    .immune-hero-{{ section_id }} .immune-hero__heading {
      font-size: {{ heading_size | times: 0.7 | round }}px;
    }
    .immune-hero-{{ section_id }} .immune-hero__btn {
      display: block;
      width: 100%;
      padding: 18px 24px;
    }
    .immune-hero-{{ section_id }} .immune-hero__description {
      font-size: {{ body_size | times: 0.95 | round }}px;
    }
  }
</style>

<section class="immune-hero-{{ section_id }}">
  <div class="immune-hero__container">
    <div class="immune-hero__content">
      {%- if section.settings.eyebrow_text != blank -%}
        <p class="immune-hero__eyebrow">{{ section.settings.eyebrow_text }}</p>
      {%- endif -%}

      {%- if section.settings.stats_text != blank -%}
        <p class="immune-hero__stats">{{ section.settings.stats_text }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="immune-hero__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.btn_label != blank -%}
        <a href="{{ section.settings.btn_link | default: '#' }}" class="immune-hero__btn">
          {{ section.settings.btn_label }}
        </a>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="immune-hero__description">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.guarantee_text != blank -%}
        <div class="immune-hero__guarantee">
          <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M3 8L6.5 11.5L13 5" stroke="{{ text_color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          <span>{{ section.settings.guarantee_text }}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="immune-hero__media">
      {%- if section.settings.product_image != blank -%}
        {{ section.settings.product_image | image_url: width: 1200 | image_tag: 
          loading: 'lazy',
          widths: '400, 600, 800, 1000, 1200',
          sizes: '(max-width: 749px) 100vw, 50vw',
          alt: section.settings.heading | default: 'Product image'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Immune Hero",
  "tag": "section",
  "class": "section-immune-hero",
  "settings": [
    {
      "type": "header",
      "content": "Contenu texte"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Texte d'introduction",
      "default": "From the makers of Grüns,"
    },
    {
      "type": "richtext",
      "id": "stats_text",
      "label": "Statistiques / Avis",
      "info": "Mettez les chiffres entre <strong></strong> pour les colorer",
      "default": "<p><strong>4.8</strong> stars | <strong>100K+</strong> reviews | <strong>1M+</strong> members</p>"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre principal",
      "default": "Your Immune System's Daily Defense Gummy"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "13 immune and everyday stress-supporting ingredients, in one pack of delicious sour pineapple-flavored gummy bears."
    },
    {
      "type": "text",
      "id": "guarantee_text",
      "label": "Texte garantie",
      "default": "30-day guarantee"
    },
    {
      "type": "header",
      "content": "Bouton"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Texte du bouton",
      "default": "Try Immūn Gummies"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Lien du bouton"
    },
    {
      "type": "header",
      "content": "Image produit"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Image du produit"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de l'image (desktop)",
      "options": [
        { "value": "right", "label": "À droite" },
        { "value": "left", "label": "À gauche" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#FEF9F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Couleur du titre",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Couleur d'accent (chiffres)",
      "default": "#F26B1A"
    },
    {
      "type": "color",
      "id": "btn_bg",
      "label": "Couleur du bouton",
      "default": "#FFF27B"
    },
    {
      "type": "color",
      "id": "btn_text_color",
      "label": "Couleur du texte du bouton",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "btn_hover_bg",
      "label": "Couleur du bouton (survol)",
      "default": "#FFE94A"
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Police des titres",
      "default": "manrope_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Police du corps de texte",
      "default": "dm_sans_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Taille du titre (px)",
      "min": 28,
      "max": 72,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Taille du texte (px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largeur max contenu (px)",
      "min": 400,
      "max": 700,
      "step": 10,
      "default": 520
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Immune Hero"
    }
  ]
}
{% endschema %}
