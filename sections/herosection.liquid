      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "discount_size_mobile",
      "label": "Taille remise mobile",
      "min": 38,
      "max": 90,
      "step": 1,
      "default": 58
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Taille description mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "button_size_mobile",
      "label": "Taille bouton mobile",
