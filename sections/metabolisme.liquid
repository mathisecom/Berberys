{% style %}
  #shopify-section-{{ section.id }} {
    --lovi-bg: {{ section.settings.background_color }};
    --lovi-text: {{ section.settings.text_color }};
    --lovi-heading: {{ section.settings.heading_color }};
    --lovi-badge-bg: {{ section.settings.badge_bg }};
    --lovi-badge-text: {{ section.settings.badge_text }};
    --lovi-card-radius: {{ section.settings.image_radius }}px;
    --lovi-section-radius: {{ section.settings.section_radius }}px;
    --lovi-max-width: {{ section.settings.max_width }}px;
    --lovi-arrow-color: {{ section.settings.arrow_color }};
  }

  #shopify-section-{{ section.id }} .lovi-metabolism {
    background: var(--lovi-bg);
    color: var(--lovi-text);
    padding: {{ section.settings.padding_top }}px 20px {{ section.settings.padding_bottom }}px;
    font-family: inherit;
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__inner {
    max-width: var(--lovi-max-width);
    margin: 0 auto;
    border-radius: var(--lovi-section-radius);
    position: relative;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__top {
    text-align: center;
    margin-bottom: {{ section.settings.header_spacing }}px;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--lovi-badge-bg);
    color: var(--lovi-badge-text);
    padding: 12px 34px;
    border-radius: 999px;
    font-size: {{ section.settings.badge_size_desktop }}px;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 34px;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__heading {
    color: var(--lovi-heading);
    font-family: inherit;
    font-size: {{ section.settings.main_title_size_desktop }}px;
    line-height: 1.05;
    font-weight: {{ section.settings.title_weight }};
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__highlight {
    display: inline-block;
    background: {{ section.settings.highlight_bg }};
    color: var(--lovi-heading);
    border-radius: 18px;
    padding: 4px 18px 10px;
    margin-top: 10px;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__timeline {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.row_gap_desktop }}px;
    position: relative;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: clamp(28px, 6vw, 80px);
    position: relative;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__row--reverse .lovi-metabolism__image-wrap {
    order: 2;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__row--reverse .lovi-metabolism__content {
    order: 1;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__image-wrap {
    width: 100%;
    position: relative;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__image {
    width: 100%;
    max-width: {{ section.settings.image_max_width }}px;
    aspect-ratio: {{ section.settings.image_ratio }};
    object-fit: cover;
    border-radius: var(--lovi-card-radius);
    display: block;
    box-shadow: 0 16px 35px rgba(0, 0, 0, {{ section.settings.shadow_opacity | divided_by: 100.0 }});
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__row--reverse .lovi-metabolism__image {
    margin-left: auto;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__content {
    max-width: 520px;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__title {
    color: var(--lovi-heading);
    font-family: inherit;
    font-size: {{ section.settings.block_title_size_desktop }}px;
    line-height: 1.2;
    font-weight: {{ section.settings.block_title_weight }};
    margin: 0 0 18px;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__text {
    font-size: {{ section.settings.text_size_desktop }}px;
    line-height: {{ section.settings.text_line_height | divided_by: 100.0 }};
    font-weight: {{ section.settings.text_weight }};
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__text p {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__arrow {
    display: flex;
    color: var(--lovi-arrow-color);
    pointer-events: none;
    position: relative;
    z-index: 1;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__arrow svg {
    width: {{ section.settings.arrow_width_desktop }}px;
    max-width: 45vw;
    height: auto;
    overflow: visible;
    animation: lovi-float-arrow-{{ section.id }} 2.2s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__arrow path {
    stroke-dasharray: 820;
    stroke-dashoffset: 820;
    animation: lovi-draw-arrow-{{ section.id }} 2.2s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__arrow--right {
    justify-content: center;
    transform: translate(
      {{ section.settings.arrow_1_desktop_x }}px,
      {{ section.settings.arrow_1_desktop_y }}px
    );
    margin: {{ section.settings.arrow_margin_desktop }}px 0;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__arrow--left {
    justify-content: center;
    transform: translate(
      {{ section.settings.arrow_2_desktop_x }}px,
      {{ section.settings.arrow_2_desktop_y }}px
    );
    margin: {{ section.settings.arrow_margin_desktop }}px 0;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__placeholder {
    width: 100%;
    max-width: {{ section.settings.image_max_width }}px;
    aspect-ratio: {{ section.settings.image_ratio }};
    border-radius: var(--lovi-card-radius);
    background: rgba(0, 0, 0, 0.06);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lovi-text);
    font-size: 14px;
  }

  #shopify-section-{{ section.id }} .lovi-metabolism__row--reverse .lovi-metabolism__placeholder {
    margin-left: auto;
  }

  @keyframes lovi-draw-arrow-{{ section.id }} {
    0% {
      stroke-dashoffset: 820;
      opacity: 0.25;
    }
    45% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0.75;
    }
  }

  @keyframes lovi-float-arrow-{{ section.id }} {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(7px);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .lovi-metabolism {
      padding: {{ section.settings.mobile_padding_top }}px 16px {{ section.settings.mobile_padding_bottom }}px;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__top {
      margin-bottom: {{ section.settings.header_spacing_mobile }}px;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__badge {
      font-size: {{ section.settings.badge_size_mobile }}px;
      padding: 10px 22px;
      margin-bottom: 26px;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__heading {
      font-size: {{ section.settings.main_title_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__highlight {
      border-radius: 14px;
      padding: 4px 12px 8px;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__timeline {
      gap: {{ section.settings.row_gap_mobile }}px;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__row,
    #shopify-section-{{ section.id }} .lovi-metabolism__row--reverse {
      grid-template-columns: 1fr;
      gap: {{ section.settings.mobile_content_gap }}px;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__row--reverse .lovi-metabolism__image-wrap,
    #shopify-section-{{ section.id }} .lovi-metabolism__row--reverse .lovi-metabolism__content {
      order: unset;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__image,
    #shopify-section-{{ section.id }} .lovi-metabolism__placeholder {
      max-width: {{ section.settings.mobile_image_width }}%;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__row:nth-of-type(1) .lovi-metabolism__image,
    #shopify-section-{{ section.id }} .lovi-metabolism__row:nth-of-type(1) .lovi-metabolism__placeholder,
    #shopify-section-{{ section.id }} .lovi-metabolism__row:nth-of-type(5) .lovi-metabolism__image,
    #shopify-section-{{ section.id }} .lovi-metabolism__row:nth-of-type(5) .lovi-metabolism__placeholder {
      margin-right: auto;
      margin-left: 0;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__row--reverse .lovi-metabolism__image,
    #shopify-section-{{ section.id }} .lovi-metabolism__row--reverse .lovi-metabolism__placeholder {
      margin-left: auto;
      margin-right: 0;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__content {
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__title {
      font-size: {{ section.settings.block_title_size_mobile }}px;
      margin-bottom: 12px;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__text {
      font-size: {{ section.settings.text_size_mobile }}px;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__arrow {
      margin: {{ section.settings.arrow_margin_mobile }}px 0;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__arrow svg {
      width: {{ section.settings.arrow_width_mobile }}px;
      max-width: 78vw;
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__arrow--right {
      justify-content: flex-end;
      padding-right: calc((100% - {{ section.settings.mobile_image_width }}%) / 2);
      transform: translate(
        {{ section.settings.arrow_1_mobile_x }}px,
        {{ section.settings.arrow_1_mobile_y }}px
      );
    }

    #shopify-section-{{ section.id }} .lovi-metabolism__arrow--left {
      justify-content: flex-start;
      padding-left: calc((100% - {{ section.settings.mobile_image_width }}%) / 2);
      transform: translate(
        {{ section.settings.arrow_2_mobile_x }}px,
        {{ section.settings.arrow_2_mobile_y }}px
      );
    }
  }
{% endstyle %}

<section class="lovi-metabolism">
  <div class="lovi-metabolism__inner">

    <div class="lovi-metabolism__top">
      {% if section.settings.badge_text_content != blank %}
        <div class="lovi-metabolism__badge">
          {{ section.settings.badge_text_content }}
        </div>
      {% endif %}

      <h2 class="lovi-metabolism__heading">
        {{ section.settings.heading_line_1 }}
        <br>
        <span class="lovi-metabolism__highlight">
          {{ section.settings.heading_line_2 }}
        </span>
      </h2>
    </div>

    <div class="lovi-metabolism__timeline">

      <div class="lovi-metabolism__row">
        <div class="lovi-metabolism__image-wrap">
          {% if section.settings.image_1 != blank %}
            {{ section.settings.image_1 | image_url: width: 900 | image_tag:
              class: 'lovi-metabolism__image',
              loading: 'lazy',
              sizes: '(max-width: 749px) 82vw, 45vw'
            }}
          {% else %}
            <div class="lovi-metabolism__placeholder">Image 1</div>
          {% endif %}
        </div>

        <div class="lovi-metabolism__content">
          <h3 class="lovi-metabolism__title">{{ section.settings.title_1 }}</h3>
          <div class="lovi-metabolism__text">
            {{ section.settings.text_1 }}
          </div>
        </div>
      </div>

      {% if section.settings.show_arrows %}
        <div class="lovi-metabolism__arrow lovi-metabolism__arrow--right">
          <svg viewBox="0 0 420 170" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M46 8C46 8 35 104 150 137C238 162 344 144 390 146M390 146L358 123M390 146L356 169" stroke="currentColor" stroke-width="{{ section.settings.arrow_thickness }}" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      {% endif %}

      <div class="lovi-metabolism__row lovi-metabolism__row--reverse">
        <div class="lovi-metabolism__image-wrap">
          {% if section.settings.image_2 != blank %}
            {{ section.settings.image_2 | image_url: width: 900 | image_tag:
              class: 'lovi-metabolism__image',
              loading: 'lazy',
              sizes: '(max-width: 749px) 82vw, 45vw'
            }}
          {% else %}
            <div class="lovi-metabolism__placeholder">Image 2</div>
          {% endif %}
        </div>

        <div class="lovi-metabolism__content">
          <h3 class="lovi-metabolism__title">{{ section.settings.title_2 }}</h3>
          <div class="lovi-metabolism__text">
            {{ section.settings.text_2 }}
          </div>
        </div>
      </div>

      {% if section.settings.show_arrows %}
        <div class="lovi-metabolism__arrow lovi-metabolism__arrow--left">
          <svg viewBox="0 0 420 170" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M374 8C374 8 385 104 270 137C182 162 76 144 30 146M30 146L62 123M30 146L64 169" stroke="currentColor" stroke-width="{{ section.settings.arrow_thickness }}" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
      {% endif %}

      <div class="lovi-metabolism__row">
        <div class="lovi-metabolism__image-wrap">
          {% if section.settings.image_3 != blank %}
            {{ section.settings.image_3 | image_url: width: 900 | image_tag:
              class: 'lovi-metabolism__image',
              loading: 'lazy',
              sizes: '(max-width: 749px) 82vw, 45vw'
            }}
          {% else %}
            <div class="lovi-metabolism__placeholder">Image 3</div>
          {% endif %}
        </div>

        <div class="lovi-metabolism__content">
          <h3 class="lovi-metabolism__title">{{ section.settings.title_3 }}</h3>
          <div class="lovi-metabolism__text">
            {{ section.settings.text_3 }}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

