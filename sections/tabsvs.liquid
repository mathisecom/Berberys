{% liquid
  assign s = section.settings
%}

<section
  id="lovi-comparison-{{ section.id }}"
  class="lovi-comparison-section"
  style="
    --section-bg: {{ s.section_bg }};
    --title-color: {{ s.title_color }};
    --text-color: {{ s.text_color }};
    --muted-color: {{ s.muted_color }};
    --accent-color: {{ s.accent_color }};
    --accent-soft: {{ s.accent_soft }};
    --row-bg: {{ s.row_bg }};
    --button-bg: {{ s.button_bg }};
    --button-text: {{ s.button_text_color }};
    --cross-color: {{ s.cross_color }};
    --font-family: {{ s.font_family }};
  "
>
  <div class="lovi-comparison-wrapper">

    {% if s.heading != blank or s.subheading != blank %}
      <div class="lovi-comparison-header">
        {% if s.heading != blank %}
          <h2>{{ s.heading }}</h2>
        {% endif %}

        {% if s.subheading != blank %}
          <p>{{ s.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="lovi-comparison-table">

      <div class="lovi-brand-column">
        <div class="lovi-brand-top">
          {% if s.lovi_image != blank %}
            <img
              src="{{ s.lovi_image | image_url: width: 180 }}"
              alt="{{ s.lovi_label | escape }}"
              loading="lazy"
            >
          {% else %}
            <div class="lovi-image-placeholder">LOVI</div>
          {% endif %}
        </div>

        {% for block in section.blocks %}
          <div class="lovi-check-cell" {{ block.shopify_attributes }}>
            <span class="lovi-check-icon">
              {{ s.check_svg }}
            </span>
          </div>
        {% endfor %}
      </div>

      <div class="lovi-other-header">
        {% if s.other_image != blank %}
          <img
            src="{{ s.other_image | image_url: width: 90 }}"
            alt="{{ s.other_label | escape }}"
            loading="lazy"
          >
        {% else %}
          <div class="lovi-other-placeholder"></div>
        {% endif %}
        <span>{{ s.other_label }}</span>
      </div>

      <div class="lovi-rows">
        {% for block in section.blocks %}
          <div class="lovi-row {% cycle 'is-plain', 'is-shaded' %}" {{ block.shopify_attributes }}>
            <div class="lovi-feature-text">
              {{ block.settings.text }}
            </div>

            <div class="lovi-spacer-cell"></div>

            <div class="lovi-cross-cell">
              <span class="lovi-cross-icon">
                {{ s.cross_svg }}
              </span>
            </div>
          </div>
        {% endfor %}
      </div>

    </div>

    {% if s.button_label != blank %}
      <div class="lovi-button-wrapper">
        <a href="{{ s.button_link }}" class="lovi-comparison-button">
          {{ s.button_label }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  #lovi-comparison-{{ section.id }} {
    background: var(--section-bg);
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: var(--font-family);
  }

  #lovi-comparison-{{ section.id }} .lovi-comparison-wrapper {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
  }

  #lovi-comparison-{{ section.id }} .lovi-comparison-header {
    text-align: center;
    margin-bottom: 38px;
  }

  #lovi-comparison-{{ section.id }} .lovi-comparison-header h2 {
    margin: 0;
    color: var(--title-color);
    font-size: {{ s.title_size }}px;
    font-weight: {{ s.title_weight }};
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  #lovi-comparison-{{ section.id }} .lovi-comparison-header p {
    max-width: 460px;
    margin: 12px auto 0;
    color: var(--muted-color);
    font-size: {{ s.subtitle_size }}px;
    font-weight: 500;
    line-height: 1.45;
  }

  #lovi-comparison-{{ section.id }} .lovi-comparison-table {
    position: relative;
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding-top: 84px;
  }

  #lovi-comparison-{{ section.id }} .lovi-rows {
    position: relative;
    z-index: 1;
  }

  #lovi-comparison-{{ section.id }} .lovi-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 86px 96px;
    align-items: center;
    min-height: {{ s.row_height }}px;
  }

  #lovi-comparison-{{ section.id }} .lovi-row.is-shaded {
    background: var(--row-bg);
  }

  #lovi-comparison-{{ section.id }} .lovi-feature-text {
    color: var(--text-color);
    font-size: {{ s.row_text_size }}px;
    font-weight: {{ s.row_text_weight }};
    line-height: 1.35;
    padding: 18px 24px;
  }

  #lovi-comparison-{{ section.id }} .lovi-spacer-cell,
  #lovi-comparison-{{ section.id }} .lovi-cross-cell {
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lovi-comparison-{{ section.id }} .lovi-cross-icon {
    width: {{ s.cross_size }}px;
    height: {{ s.cross_size }}px;
    color: var(--cross-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #lovi-comparison-{{ section.id }} .lovi-cross-icon svg {
    width: 100%;
    height: 100%;
    display: block;
    stroke: currentColor;
  }

  #lovi-comparison-{{ section.id }} .lovi-brand-column {
    position: absolute;
    z-index: 4;
    top: 0;
    left: calc(100% - 182px);
    width: 86px;
    background: var(--accent-color);
    border-radius: 24px;
    padding: 20px 12px 22px;
    box-shadow: 0 12px 24px rgba(47, 92, 71, 0.22);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #lovi-comparison-{{ section.id }} .lovi-brand-top {
    height: 92px;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    margin-bottom: 2px;
  }

  #lovi-comparison-{{ section.id }} .lovi-brand-top img {
    max-width: {{ s.product_image_width }}px;
    height: auto;
    display: block;
  }

  #lovi-comparison-{{ section.id }} .lovi-image-placeholder {
    width: 54px;
    height: 64px;
    background: #ffffff;
    border-radius: 8px;
    color: var(--accent-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 800;
  }

  #lovi-comparison-{{ section.id }} .lovi-check-cell {
    height: {{ s.row_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #lovi-comparison-{{ section.id }} .lovi-check-icon {
    width: {{ s.check_circle_size }}px;
    height: {{ s.check_circle_size }}px;
    border-radius: 999px;
    background: var(--accent-soft);
    color: var(--accent-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #lovi-comparison-{{ section.id }} .lovi-check-icon svg {
    width: {{ s.check_size }}px;
    height: {{ s.check_size }}px;
    display: block;
    stroke: currentColor;
  }

  #lovi-comparison-{{ section.id }} .lovi-other-header {
    position: absolute;
    z-index: 3;
    top: 8px;
    right: 34px;
    width: 96px;
    height: 72px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
  }

  #lovi-comparison-{{ section.id }} .lovi-other-header img {
    max-width: {{ s.other_image_width }}px;
    height: auto;
    display: block;
    margin-bottom: 8px;
  }

  #lovi-comparison-{{ section.id }} .lovi-other-placeholder {
    width: 34px;
    height: 38px;
    border-radius: 8px;
    background: linear-gradient(90deg, #e5e5e5, #ffffff, #d8d8d8);
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.08);
    margin-bottom: 8px;
  }

  #lovi-comparison-{{ section.id }} .lovi-other-header span {
    color: var(--text-color);
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
  }

  #lovi-comparison-{{ section.id }} .lovi-button-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 34px;
  }

  #lovi-comparison-{{ section.id }} .lovi-comparison-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: {{ s.button_width }}px;
    min-height: {{ s.button_height }}px;
    padding: 0 34px;
    border-radius: 999px;
    background: var(--button-bg);
    color: var(--button-text);
    text-decoration: none;
    font-size: {{ s.button_text_size }}px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: .02em;
    text-transform: uppercase;
    box-shadow: 0 8px 18px rgba(47, 92, 71, 0.18);
    transition: transform .2s ease, opacity .2s ease;
  }

  #lovi-comparison-{{ section.id }} .lovi-comparison-button:hover {
    transform: translateY(-2px);
    opacity: .92;
  }

  @media screen and (max-width: 749px) {
    #lovi-comparison-{{ section.id }} {
      padding: {{ s.mobile_padding_top }}px 20px {{ s.mobile_padding_bottom }}px;
    }

    #lovi-comparison-{{ section.id }} .lovi-comparison-header {
      margin-bottom: 24px;
    }

    #lovi-comparison-{{ section.id }} .lovi-comparison-header h2 {
      font-size: {{ s.mobile_title_size }}px;
    }

    #lovi-comparison-{{ section.id }} .lovi-comparison-header p {
      font-size: {{ s.mobile_subtitle_size }}px;
    }

    #lovi-comparison-{{ section.id }} .lovi-comparison-table {
      max-width: 100%;
      padding-top: 78px;
    }

    #lovi-comparison-{{ section.id }} .lovi-row {
      grid-template-columns: minmax(0, 1fr) 72px 64px;
      min-height: {{ s.mobile_row_height }}px;
    }

    #lovi-comparison-{{ section.id }} .lovi-feature-text {
      font-size: {{ s.mobile_row_text_size }}px;
      padding: 14px 16px;
    }

    #lovi-comparison-{{ section.id }} .lovi-brand-column {
      left: calc(100% - 144px);
      width: 72px;
      border-radius: 22px;
      padding: 16px 9px 18px;
    }

    #lovi-comparison-{{ section.id }} .lovi-brand-top {
      height: 88px;
    }

    #lovi-comparison-{{ section.id }} .lovi-brand-top img {
      max-width: {{ s.mobile_product_image_width }}px;
    }

    #lovi-comparison-{{ section.id }} .lovi-check-cell {
      height: {{ s.mobile_row_height }}px;
    }

    #lovi-comparison-{{ section.id }} .lovi-check-icon {
      width: {{ s.mobile_check_circle_size }}px;
      height: {{ s.mobile_check_circle_size }}px;
    }

    #lovi-comparison-{{ section.id }} .lovi-check-icon svg {
      width: {{ s.mobile_check_size }}px;
      height: {{ s.mobile_check_size }}px;
    }

    #lovi-comparison-{{ section.id }} .lovi-other-header {
      top: 8px;
      right: 4px;
      width: 64px;
    }

    #lovi-comparison-{{ section.id }} .lovi-other-header img {
      max-width: {{ s.mobile_other_image_width }}px;
    }

    #lovi-comparison-{{ section.id }} .lovi-other-header span {
      font-size: 12px;
    }

    #lovi-comparison-{{ section.id }} .lovi-cross-icon {
      width: {{ s.mobile_cross_size }}px;
      height: {{ s.mobile_cross_size }}px;
    }

    #lovi-comparison-{{ section.id }} .lovi-button-wrapper {
      margin-top: 32px;
    }

    #lovi-comparison-{{ section.id }} .lovi-comparison-button {
      width: 100%;
      min-width: 0;
      min-height: {{ s.mobile_button_height }}px;
      font-size: {{ s.mobile_button_text_size }}px;
    }
  }
</style>

{% schema %}
{
  "name": "Comparatif LOVI",
  "settings": [
    {
      "type": "header",
      "content": "Textes"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Pourquoi LOVI n'est pas comme les autres"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Sous-titre",
      "default": "Une formule pensée pour les femmes 45+, là où les autres restent génériques."
    },
    {
      "type": "text",
      "id": "other_label",
      "label": "Texte colonne autres",
      "default": "Autres"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte bouton",
      "default": "JE CHOISIS LOVI →"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien bouton"
    },
    {
      "type": "header",
      "content": "Images"
    },
    {
      "type": "image_picker",
      "id": "lovi_image",
      "label": "Image produit LOVI"
    },
    {
      "type": "image_picker",
      "id": "other_image",
      "label": "Image produit autres"
    },
    {
      "type": "range",
      "id": "product_image_width",
      "label": "Largeur image LOVI desktop",
      "min": 30,
      "max": 100,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_product_image_width",
      "label": "Largeur image LOVI mobile",
      "min": 28,
      "max": 90,
      "step": 2,
      "default": 52
    },
    {
      "type": "range",
      "id": "other_image_width",
      "label": "Largeur image autres desktop",
      "min": 20,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "mobile_other_image_width",
      "label": "Largeur image autres mobile",
      "min": 18,
      "max": 70,
      "step": 2,
      "default": 36
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Fond section",
      "default": "#FEF9F0"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Colonne LOVI",
      "default": "#2F5C47"
    },
    {
      "type": "color",
      "id": "accent_soft",
      "label": "Fond rond check",
      "default": "#CFF5A8"
    },
    {
      "type": "color",
      "id": "row_bg",
      "label": "Fond lignes alternées",
      "default": "#F7EFD9"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Fond bouton",
      "default": "#FFF27B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texte bouton",
      "default": "#2F5C47"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur titre",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur texte",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Couleur sous-titre",
      "default": "#6F7480"
    },
    {
      "type": "color",
      "id": "cross_color",
      "label": "Couleur croix",
      "default": "#EF6B63"
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Typographie",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Typographie du thème"
        },
        {
          "value": "Arial, sans-serif",
          "label": "Arial"
        },
        {
          "value": "Helvetica, Arial, sans-serif",
          "label": "Helvetica"
        },
        {
          "value": "Georgia, serif",
          "label": "Georgia"
        },
        {
          "value": "'Poppins', sans-serif",
          "label": "Poppins si installé"
        },
        {
          "value": "'Montserrat', sans-serif",
          "label": "Montserrat si installé"
        }
      ]
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille titre desktop",
      "min": 20,
      "max": 56,
      "step": 1,
      "default": 34
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Taille titre mobile",
      "min": 18,
      "max": 38,
      "step": 1,
      "default": 26
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Graisse titre",
      "default": "400",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "range",
      "id": "subtitle_size",
      "label": "Taille sous-titre desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_subtitle_size",
      "label": "Taille sous-titre mobile",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "row_text_size",
      "label": "Taille texte lignes desktop",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "mobile_row_text_size",
      "label": "Taille texte lignes mobile",
      "min": 11,
      "max": 20,
      "step": 1,
      "default": 15
    },
    {
      "type": "select",
      "id": "row_text_weight",
      "label": "Graisse texte lignes",
      "default": "500",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" }
      ]
    },
    {
      "type": "header",
      "content": "Tailles et espacements"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur maximale",
      "min": 520,
      "max": 1200,
      "step": 20,
      "default": 760
    },
    {
      "type": "range",
      "id": "row_height",
      "label": "Hauteur ligne desktop",
      "min": 48,
      "max": 92,
      "step": 2,
      "default": 72
    },
    {
      "type": "range",
      "id": "mobile_row_height",
      "label": "Hauteur ligne mobile",
      "min": 50,
      "max": 96,
      "step": 2,
      "default": 80
    },
    {
      "type": "range",
      "id": "check_circle_size",
      "label": "Taille rond check desktop",
      "min": 26,
      "max": 58,
      "step": 2,
      "default": 38
    },
    {
      "type": "range",
      "id": "mobile_check_circle_size",
      "label": "Taille rond check mobile",
      "min": 24,
      "max": 54,
      "step": 2,
      "default": 36
    },
    {
      "type": "range",
      "id": "check_size",
      "label": "Taille icône check desktop",
      "min": 12,
      "max": 34,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "mobile_check_size",
      "label": "Taille icône check mobile",
      "min": 12,
      "max": 30,
      "step": 1,
      "default": 21
    },
    {
      "type": "range",
      "id": "cross_size",
      "label": "Taille croix desktop",
      "min": 14,
      "max": 34,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "mobile_cross_size",
      "label": "Taille croix mobile",
      "min": 14,
      "max": 32,
      "step": 1,
      "default": 22
    },
    {
      "type": "range",
      "id": "button_width",
      "label": "Largeur bouton desktop",
      "min": 160,
      "max": 420,
      "step": 10,
      "default": 240
    },
    {
      "type": "range",
      "id": "button_height",
      "label": "Hauteur bouton desktop",
      "min": 42,
      "max": 76,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_button_height",
      "label": "Hauteur bouton mobile",
      "min": 44,
      "max": 80,
      "step": 2,
      "default": 58
    },
    {
      "type": "range",
      "id": "button_text_size",
      "label": "Taille texte bouton desktop",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_button_text_size",
      "label": "Taille texte bouton mobile",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge interne haut desktop",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge interne bas desktop",
      "min": 20,
      "max": 120,
      "step": 4,
      "default": 56
    },
    {
      "type": "range",
      "id": "mobile_padding_top",
      "label": "Marge interne haut mobile",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 36
    },
    {
      "type": "range",
      "id": "mobile_padding_bottom",
      "label": "Marge interne bas mobile",
      "min": 20,
      "max": 100,
      "step": 4,
      "default": 44
    },
    {
      "type": "header",
      "content": "SVG modifiables"
    },
    {
      "type": "html",
      "id": "check_svg",
      "label": "SVG check",
      "default": "<svg viewBox='0 0 24 24' fill='none' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'><path d='M5 12.5l4.2 4.2L19 7'></path></svg>"
    },
    {
      "type": "html",
