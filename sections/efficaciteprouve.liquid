{% comment %}
  Section Shopify : Efficacité prouvée
  Police titres : Manrope
  Police paragraphes : DM Sans
{% endcomment %}

<section
  id="efficacite-prouvee-{{ section.id }}"
  class="efficacite-prouvee-section"
  style="
    --bg-color: {{ section.settings.bg_color }};
    --title-color: {{ section.settings.title_color }};
    --text-color: {{ section.settings.text_color }};
    --muted-color: {{ section.settings.muted_color }};
    --line-color: {{ section.settings.line_color }};
    --badge-bg: {{ section.settings.badge_bg }};
    --badge-color: {{ section.settings.badge_color }};
    --max-width: {{ section.settings.max_width }}px;

    --padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --padding-left-desktop: {{ section.settings.padding_left_desktop }}px;
    --padding-right-desktop: {{ section.settings.padding_right_desktop }}px;

    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --padding-left-mobile: {{ section.settings.padding_left_mobile }}px;
    --padding-right-mobile: {{ section.settings.padding_right_mobile }}px;

    --image-size-desktop: {{ section.settings.image_size_desktop }}px;
    --image-size-mobile: {{ section.settings.image_size_mobile }}px;
  "
>
  <div class="efficacite-prouvee-inner">

    <div class="efficacite-prouvee-content">
      <div class="efficacite-prouvee-header">
        {% if section.settings.title != blank %}
          <h2>{{ section.settings.title }}</h2>
        {% endif %}

        {% if section.settings.badge_text != blank %}
          <div class="efficacite-prouvee-badge">
            {{ section.settings.badge_text }}
          </div>
        {% endif %}
      </div>

      <div class="efficacite-prouvee-stats">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
            <div class="efficacite-prouvee-stat" {{ block.shopify_attributes }}>
              {% if block.settings.number != blank %}
                <div class="stat-number">{{ block.settings.number }}</div>
              {% endif %}

              {% if block.settings.text != blank %}
                <p>{{ block.settings.text }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if section.settings.sources != blank %}
        <div class="efficacite-prouvee-sources">
          {{ section.settings.sources }}
        </div>
      {% endif %}
    </div>

    <div class="efficacite-prouvee-image-wrapper">
      {% if section.settings.main_image != blank %}
        {{
          section.settings.main_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            class: 'efficacite-prouvee-image',
            alt: section.settings.title
        }}
      {% else %}
        <div class="efficacite-prouvee-placeholder">
          {{ 'product-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Manrope:wght@400;500;600;700;800&display=swap');

  #efficacite-prouvee-{{ section.id }} {
    background: var(--bg-color);
    padding:
      var(--padding-top-desktop)
      var(--padding-right-desktop)
      var(--padding-bottom-desktop)
      var(--padding-left-desktop);
    overflow: hidden;
  }

  #efficacite-prouvee-{{ section.id }} * {
    box-sizing: border-box;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-inner {
    position: relative;
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: {{ section.settings.desktop_gap }}px;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-content {
    max-width: {{ section.settings.content_width }}px;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-header {
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  #efficacite-prouvee-{{ section.id }} h2 {
    margin: 0 0 {{ section.settings.badge_margin_top }}px;
    color: var(--title-color);
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.title_size_desktop }}px;
    line-height: 1.05;
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: -0.06em;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    padding: {{ section.settings.badge_padding_y }}px {{ section.settings.badge_padding_x }}px;
    background: var(--badge-bg);
    color: var(--badge-color);
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.badge_size_desktop }}px;
    line-height: 1;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: {{ section.settings.badge_radius }}px;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: {{ section.settings.stats_column_gap }}px;
    row-gap: 0;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-stat {
    padding:
      {{ section.settings.stat_padding_top }}px
      0
      {{ section.settings.stat_padding_bottom }}px;
    border-bottom: {{ section.settings.line_width }}px solid var(--line-color);
  }

  #efficacite-prouvee-{{ section.id }} .stat-number {
    margin: 0 0 {{ section.settings.number_margin_bottom }}px;
    color: var(--title-color);
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.number_size_desktop }}px;
    line-height: 0.95;
    font-weight: {{ section.settings.number_weight }};
    letter-spacing: -0.06em;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-stat p {
    margin: 0;
    color: var(--text-color);
    font-family: 'DM Sans', sans-serif;
    font-size: {{ section.settings.text_size_desktop }}px;
    line-height: 1.35;
    font-weight: {{ section.settings.text_weight }};
    letter-spacing: -0.01em;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-sources {
    margin-top: {{ section.settings.sources_margin_top }}px;
    color: var(--muted-color);
    font-family: 'DM Sans', sans-serif;
    font-size: {{ section.settings.sources_size_desktop }}px;
    line-height: 1.25;
    font-weight: 400;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-sources p {
    margin: 0;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-image-wrapper {
    width: var(--image-size-desktop);
    height: var(--image-size-desktop);
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    box-shadow: {{ section.settings.image_shadow_x }}px {{ section.settings.image_shadow_y }}px {{ section.settings.image_shadow_blur }}px rgba(0,0,0,{{ section.settings.image_shadow_opacity | divided_by: 100.0 }});
    border: {{ section.settings.image_border_width }}px solid {{ section.settings.image_border_color }};
    background: #fff;
  }

  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-image,
  #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  @media screen and (max-width: 989px) {
    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-inner {
      gap: {{ section.settings.tablet_gap }}px;
    }

    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-image-wrapper {
      width: {{ section.settings.image_size_tablet }}px;
      height: {{ section.settings.image_size_tablet }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #efficacite-prouvee-{{ section.id }} {
      padding:
        var(--padding-top-mobile)
        var(--padding-right-mobile)
        var(--padding-bottom-mobile)
        var(--padding-left-mobile);
    }

    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-inner {
      display: block;
      max-width: 100%;
      min-height: auto;
    }

    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-content {
      max-width: 100%;
      position: relative;
      z-index: 2;
    }

    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-header {
      min-height: calc(var(--image-size-mobile) * 0.7);
      margin-bottom: {{ section.settings.header_margin_bottom_mobile }}px;
      padding-right: calc(var(--image-size-mobile) * 0.58);
    }

    #efficacite-prouvee-{{ section.id }} h2 {
      font-size: {{ section.settings.title_size_mobile }}px;
      line-height: 1.04;
      margin-bottom: {{ section.settings.badge_margin_top_mobile }}px;
    }

    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-badge {
      font-size: {{ section.settings.badge_size_mobile }}px;
      padding: {{ section.settings.badge_padding_y_mobile }}px {{ section.settings.badge_padding_x_mobile }}px;
      border-radius: {{ section.settings.badge_radius }}px;
    }

    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-image-wrapper {
      position: absolute;
      top: {{ section.settings.image_top_mobile }}px;
      right: {{ section.settings.image_right_mobile }}px;
      width: var(--image-size-mobile);
      height: var(--image-size-mobile);
      z-index: 1;
    }

    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-stats {
      grid-template-columns: 1fr;
      row-gap: 0;
      column-gap: 0;
    }

    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-stat {
      padding:
        {{ section.settings.stat_padding_top_mobile }}px
        0
        {{ section.settings.stat_padding_bottom_mobile }}px;
    }

    #efficacite-prouvee-{{ section.id }} .stat-number {
      font-size: {{ section.settings.number_size_mobile }}px;
      margin-bottom: {{ section.settings.number_margin_bottom_mobile }}px;
    }

    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-stat p {
      font-size: {{ section.settings.text_size_mobile }}px;
      line-height: 1.35;
    }

    #efficacite-prouvee-{{ section.id }} .efficacite-prouvee-sources {
      margin-top: {{ section.settings.sources_margin_top_mobile }}px;
      font-size: {{ section.settings.sources_size_mobile }}px;
      line-height: 1.25;
    }
  }
</style>

{% schema %}
{
  "name": "Efficacité prouvée",
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Efficacité prouvée"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Texte du badge",
      "default": "PAR LA SCIENCE"
    },
    {
      "type": "richtext",
      "id": "sources",
      "label": "Sources / notes",
      "default": "<p>¹ Recherche base pubmed, 2025<br>² Rashidi et al, Jundishapur Journal of Natural Products – 2018<br>³ Ruscica et al, Journal of Clinical Lipidology, 2014</p>"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Image ronde"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur des titres/chiffres",
      "default": "#091344"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur des paragraphes",
      "default": "#6f6f6f"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Couleur des sources",
      "default": "#c7c7c7"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Couleur des lignes",
      "default": "#d2d2d2"
    },
    {
      "type": "color",
      "id": "badge_bg",
      "label": "Fond du badge",
      "default": "#091344"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Texte du badge",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Typographie titre"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Taille titre PC",
      "min": 28,
      "max": 90,
      "step": 1,
      "default": 58
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Taille titre mobile",
      "min": 28,
      "max": 60,
      "step": 1,
      "default": 39
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Épaisseur titre",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra-bold"
        }
      ]
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "range",
      "id": "badge_size_desktop",
      "label": "Taille badge PC",
      "min": 8,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "badge_size_mobile",
      "label": "Taille badge mobile",
      "min": 8,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "badge_padding_x",
      "label": "Padding horizontal badge PC",
      "min": 4,
      "max": 28,
      "step": 1,
      "default": 9
    },
    {
      "type": "range",
      "id": "badge_padding_y",
      "label": "Padding vertical badge PC",
      "min": 2,
      "max": 18,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "badge_padding_x_mobile",
      "label": "Padding horizontal badge mobile",
      "min": 4,
      "max": 24,
      "step": 1,
      "default": 7
    },
    {
      "type": "range",
      "id": "badge_padding_y_mobile",
      "label": "Padding vertical badge mobile",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "badge_radius",
      "label": "Arrondi badge",
      "min": 0,
      "max": 20,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "badge_margin_top",
      "label": "Espace titre / badge PC",
      "min": 10,
      "max": 80,
      "step": 2,
      "default": 40
    },
    {
      "type": "range",
      "id": "badge_margin_top_mobile",
      "label": "Espace titre / badge mobile",
      "min": 8,
      "max": 60,
      "step": 2,
      "default": 34
    },
    {
      "type": "header",
      "content": "Statistiques"
    },
    {
      "type": "range",
      "id": "number_size_desktop",
      "label": "Taille chiffres PC",
      "min": 30,
      "max": 90,
      "step": 1,
      "default": 58
    },
    {
      "type": "range",
      "id": "number_size_mobile",
      "label": "Taille chiffres mobile",
      "min": 34,
      "max": 80,
      "step": 1,
      "default": 49
    },
    {
      "type": "select",
      "id": "number_weight",
      "label": "Épaisseur chiffres",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra-bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_size_desktop",
      "label": "Taille texte stats PC",
      "min": 11,
      "max": 26,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "Taille texte stats mobile",
      "min": 11,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "select",
      "id": "text_weight",
      "label": "Épaisseur paragraphes",
      "default": "500",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "stats_column_gap",
      "label": "Espace entre colonnes PC",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 60
    },
    {
      "type": "range",
      "id": "stat_padding_top",
      "label": "Padding haut stat PC",
      "min": 10,
      "max": 70,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "stat_padding_bottom",
      "label": "Padding bas stat PC",
      "min": 10,
      "max": 70,
      "step": 2,
      "default": 30
    },
    {
      "type": "range",
      "id": "stat_padding_top_mobile",
      "label": "Padding haut stat mobile",
      "min": 10,
      "max": 70,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "stat_padding_bottom_mobile",
      "label": "Padding bas stat mobile",
      "min": 10,
      "max": 70,
      "step": 2,
      "default": 28
    },
    {
      "type": "range",
      "id": "number_margin_bottom",
      "label": "Espace chiffre / texte PC",
      "min": 4,
      "max": 30,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "number_margin_bottom_mobile",
      "label": "Espace chiffre / texte mobile",
      "min": 4,
      "max": 30,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "line_width",
      "label": "Épaisseur des lignes",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 1
    },
    {
      "type": "header",
      "content": "Sources"
    },
    {
      "type": "range",
      "id": "sources_size_desktop",
      "label": "Taille sources PC",
      "min": 8,
      "max": 18,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "sources_size_mobile",
      "label": "Taille sources mobile",
      "min": 8,
      "max": 16,
      "step": 1,
      "default": 10
    },
    {
      "type": "range",
      "id": "sources_margin_top",
      "label": "Marge sources PC",
      "min": 8,
      "max": 60,
      "step": 2,
      "default": 24
    },
    {
      "type": "range",
      "id": "sources_margin_top_mobile",
      "label": "Marge sources mobile",
      "min": 8,
      "max": 50,
      "step": 2,
      "default": 18
    },
    {
      "type": "header",
      "content": "Image ronde"
    },
    {
      "type": "range",
      "id": "image_size_desktop",
      "label": "Taille image PC",
      "min": 180,
      "max": 560,
      "step": 10,
      "default": 390
    },
    {
      "type": "range",
      "id": "image_size_tablet",
      "label": "Taille image tablette",
      "min": 140,
      "max": 420,
      "step": 10,
      "default": 280
    },
    {
      "type": "range",
      "id": "image_size_mobile",
      "label": "Taille image mobile",
      "min": 80,
      "max": 190,
      "step": 5,
      "default": 120
    },
    {
      "type": "range",
      "id": "image_top_mobile",
      "label": "Position image haut mobile",
      "min": 0,
      "max": 120,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "image_right_mobile",
      "label": "Position image droite mobile",
      "min": -40,
      "max": 80,
      "step": 2,
      "default": 0
    },
    {
      "type": "range",
      "id": "image_border_width",
      "label": "Épaisseur bordure image",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 0
    },
    {
      "type": "color",
      "id": "image_border_color",
      "label": "Couleur bordure image",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "image_shadow_x",
      "label": "Ombre image axe X",
      "min": -20,
      "max": 20,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "image_shadow_y",
      "label": "Ombre image axe Y",
      "min": -20,
      "max": 20,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "image_shadow_blur",
      "label": "Flou ombre image",
      "min": 0,
      "max": 40,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "image_shadow_opacity",
      "label": "Opacité ombre image",
      "min": 0,
      "max": 80,
      "step": 5,
      "default": 25
    },
    {
      "type": "header",
      "content": "Largeurs et espacements"
    },
