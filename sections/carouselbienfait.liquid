{% comment %}
  Section : Benefits Cure Slider
  Créée pour Shopify Online Store 2.0
{% endcomment %}

<section
  id="benefits-cure-{{ section.id }}"
  class="benefits-cure-section"
  style="
    --section-bg: {{ section.settings.section_bg }};
    --title-color: {{ section.settings.title_color }};
    --italic-color: {{ section.settings.italic_color }};
    --card-radius: {{ section.settings.card_radius }}px;
    --desktop-card-width: {{ section.settings.desktop_card_width }}px;
    --mobile-card-width: {{ section.settings.mobile_card_width }}px;
    --desktop-card-height: {{ section.settings.desktop_card_height }}px;
    --mobile-card-height: {{ section.settings.mobile_card_height }}px;
    --gap-desktop: {{ section.settings.gap_desktop }}px;
    --gap-mobile: {{ section.settings.gap_mobile }}px;
    --overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --padding-left-desktop: {{ section.settings.padding_left_desktop }}px;
    --padding-right-desktop: {{ section.settings.padding_right_desktop }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --padding-left-mobile: {{ section.settings.padding_left_mobile }}px;
    --padding-right-mobile: {{ section.settings.padding_right_mobile }}px;
  "
>
  <div class="benefits-cure-header">
    <h2 class="benefits-cure-title">
      {{ section.settings.title_before }}
      <span>{{ section.settings.title_italic }}</span>
      {{ section.settings.title_after }}
    </h2>

    {% if section.settings.show_arrows %}
      <div class="benefits-cure-arrows">
        <button class="benefits-cure-arrow benefits-cure-prev" aria-label="Précédent">
          ←
        </button>
        <button class="benefits-cure-arrow benefits-cure-next" aria-label="Suivant">
          →
        </button>
      </div>
    {% endif %}
  </div>

  <div class="benefits-cure-slider-wrapper">
    <div class="benefits-cure-slider">
      {% for block in section.blocks %}
        <article class="benefits-cure-card" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{
              block.settings.image
              | image_url: width: 900
              | image_tag:
                loading: 'lazy',
                class: 'benefits-cure-image',
                alt: block.settings.title
            }}
          {% else %}
            <div class="benefits-cure-placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}

          <div class="benefits-cure-overlay"></div>

          {% if block.settings.badge != blank %}
            <div class="benefits-cure-badge">
              {{ block.settings.badge }}
            </div>
          {% endif %}

          <div class="benefits-cure-content">
            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}

            {% if section.settings.show_bottom_line %}
              <div class="benefits-cure-line"></div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

<style>
  #benefits-cure-{{ section.id }} {
    background: var(--section-bg);
    padding:
      var(--padding-top-desktop)
      var(--padding-right-desktop)
      var(--padding-bottom-desktop)
      var(--padding-left-desktop);
    overflow: hidden;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: {{ section.settings.title_margin_bottom }}px;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-title {
    margin: 0;
    color: var(--title-color);
    font-size: {{ section.settings.title_size_desktop }}px;
    line-height: 1.1;
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: -0.02em;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-title span {
    color: var(--italic-color);
    font-family: Georgia, 'Times New Roman', serif;
    font-style: italic;
    font-weight: 400;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-arrows {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-arrow {
    border: none;
    background: transparent;
    color: {{ section.settings.arrow_color }};
    font-size: {{ section.settings.arrow_size }}px;
    line-height: 1;
    cursor: pointer;
    padding: 4px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-arrow:hover {
    opacity: 0.65;
    transform: translateY(-1px);
  }

  #benefits-cure-{{ section.id }} .benefits-cure-slider-wrapper {
    width: 100%;
    overflow: visible;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-slider {
    display: flex;
    gap: var(--gap-desktop);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 2px;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-slider::-webkit-scrollbar {
    display: none;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-card {
    position: relative;
    flex: 0 0 var(--desktop-card-width);
    width: var(--desktop-card-width);
    height: var(--desktop-card-height);
    border-radius: var(--card-radius);
    overflow: hidden;
    scroll-snap-align: start;
    background: #ddd;
    color: #fff;
    isolation: isolate;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-image,
  #benefits-cure-{{ section.id }} .benefits-cure-placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        to bottom,
        rgba(0,0,0,0.12) 0%,
        rgba(0,0,0,0.08) 35%,
        rgba(0,0,0,var(--overlay-opacity)) 100%
      );
  }

  #benefits-cure-{{ section.id }} .benefits-cure-badge {
    position: absolute;
    z-index: 2;
    top: {{ section.settings.badge_top }}px;
    left: {{ section.settings.badge_left }}px;
    padding: {{ section.settings.badge_padding_y }}px {{ section.settings.badge_padding_x }}px;
    border: 1px solid rgba(255,255,255,0.95);
    border-radius: 999px;
    color: {{ section.settings.badge_color }};
    background: {{ section.settings.badge_bg }};
    font-size: {{ section.settings.badge_size }}px;
    line-height: 1;
    font-weight: 700;
    text-transform: uppercase;
    backdrop-filter: blur(3px);
  }

  #benefits-cure-{{ section.id }} .benefits-cure-content {
    position: absolute;
    z-index: 2;
    left: {{ section.settings.content_left }}px;
    right: {{ section.settings.content_right }}px;
    bottom: {{ section.settings.content_bottom }}px;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-content h3 {
    margin: 0 0 6px;
    color: {{ section.settings.card_title_color }};
    font-size: {{ section.settings.card_title_size_desktop }}px;
    line-height: 1.2;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-content p {
    margin: 0;
    color: {{ section.settings.card_text_color }};
    font-size: {{ section.settings.card_text_size_desktop }}px;
    line-height: 1.35;
    font-weight: 500;
  }

  #benefits-cure-{{ section.id }} .benefits-cure-line {
    width: 100%;
    height: 2px;
    margin-top: {{ section.settings.line_margin_top }}px;
    background: rgba(255,255,255,0.8);
  }

  @media screen and (max-width: 749px) {
    #benefits-cure-{{ section.id }} {
      padding:
        var(--padding-top-mobile)
        var(--padding-right-mobile)
        var(--padding-bottom-mobile)
        var(--padding-left-mobile);
    }

    #benefits-cure-{{ section.id }} .benefits-cure-header {
      margin-bottom: {{ section.settings.title_margin_bottom_mobile }}px;
    }

    #benefits-cure-{{ section.id }} .benefits-cure-title {
      font-size: {{ section.settings.title_size_mobile }}px;
      line-height: 1.1;
    }

    #benefits-cure-{{ section.id }} .benefits-cure-arrows {
      {% if section.settings.hide_arrows_mobile %}
        display: none;
      {% endif %}
    }

    #benefits-cure-{{ section.id }} .benefits-cure-slider {
      gap: var(--gap-mobile);
      overflow-x: auto;
      padding-right: 20vw;
    }

    #benefits-cure-{{ section.id }} .benefits-cure-card {
      flex-basis: var(--mobile-card-width);
      width: var(--mobile-card-width);
      height: var(--mobile-card-height);
    }

    #benefits-cure-{{ section.id }} .benefits-cure-content {
      left: {{ section.settings.content_left_mobile }}px;
      right: {{ section.settings.content_right_mobile }}px;
      bottom: {{ section.settings.content_bottom_mobile }}px;
    }

    #benefits-cure-{{ section.id }} .benefits-cure-content h3 {
      font-size: {{ section.settings.card_title_size_mobile }}px;
    }

    #benefits-cure-{{ section.id }} .benefits-cure-content p {
      font-size: {{ section.settings.card_text_size_mobile }}px;
    }

    #benefits-cure-{{ section.id }} .benefits-cure-badge {
      top: {{ section.settings.badge_top_mobile }}px;
      left: {{ section.settings.badge_left_mobile }}px;
      font-size: {{ section.settings.badge_size_mobile }}px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#benefits-cure-{{ section.id }}');
    if (!section) return;

    const slider = section.querySelector('.benefits-cure-slider');
    const prev = section.querySelector('.benefits-cure-prev');
    const next = section.querySelector('.benefits-cure-next');

    if (!slider || !prev || !next) return;

    function getScrollAmount() {
      const card = slider.querySelector('.benefits-cure-card');
      if (!card) return 300;

      const gap = parseFloat(window.getComputedStyle(slider).gap) || 16;
      return card.offsetWidth + gap;
    }

    prev.addEventListener('click', function () {
      slider.scrollBy({
        left: -getScrollAmount(),
        behavior: 'smooth'
      });
    });

    next.addEventListener('click', function () {
      slider.scrollBy({
        left: getScrollAmount(),
        behavior: 'smooth'
      });
    });
  });
</script>

{% schema %}
