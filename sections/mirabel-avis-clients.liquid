<script>
  (() => {
    const initMirabelReviews = (root) => {
      if (!root || root.dataset.mvrInitialized === 'true') return;
      root.dataset.mvrInitialized = 'true';

      const reviews = Array.from(root.querySelectorAll('[data-mvr-review]'));
      const search = root.querySelector('[data-mvr-search]');
      const ratingButtons = Array.from(root.querySelectorAll('[data-mvr-rating]'));
      const pagination = root.querySelector('[data-mvr-pagination]');
      const emptyState = root.querySelector('[data-mvr-empty]');
      const resultCount = root.querySelector('[data-mvr-results-count]');
      const pageSize = Math.max(1, Number(root.dataset.pageSize || 6));
      const displayedSingular = root.dataset.displayedSingular || 'avis affiché';
      const displayedPlural = root.dataset.displayedPlural || 'avis affichés';

      let currentPage = 1;
      let activeRating = 'all';
      let query = '';

      const normalize = (value) => String(value || '')
        .toLocaleLowerCase('fr')
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '');

      const filteredReviews = () => reviews.filter((review) => {
        const ratingMatch = activeRating === 'all' || review.dataset.rating === activeRating;
        const searchMatch = !query || normalize(review.textContent).includes(normalize(query));
        return ratingMatch && searchMatch;
      });

      const makeButton = (label, options = {}) => {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = label;
        if (options.className) button.className = options.className;
        if (options.disabled) button.disabled = true;
        if (options.ariaLabel) button.setAttribute('aria-label', options.ariaLabel);
        if (options.onClick) button.addEventListener('click', options.onClick);
        return button;
      };

      const renderPagination = (pages) => {
        if (!pagination) return;
        pagination.replaceChildren();
        if (pages <= 1) return;

        pagination.appendChild(makeButton('‹', {
          disabled: currentPage === 1,
          ariaLabel: 'Page précédente',
          onClick: () => {
            currentPage -= 1;
            render();
            root.querySelector('[data-mvr-list]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }));

        const visiblePages = [];
        for (let page = 1; page <= pages; page += 1) {
          if (page === 1 || page === pages || Math.abs(page - currentPage) <= 1) visiblePages.push(page);
        }

        let previousPage = 0;
        visiblePages.forEach((page) => {
          if (page - previousPage > 1) {
            const ellipsis = document.createElement('span');
            ellipsis.textContent = '…';
            ellipsis.setAttribute('aria-hidden', 'true');
            pagination.appendChild(ellipsis);
          }

          pagination.appendChild(makeButton(String(page), {
            className: page === currentPage ? 'is-active' : '',
            ariaLabel: `Page ${page}`,
            onClick: () => {
              currentPage = page;
              render();
              root.querySelector('[data-mvr-list]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
          }));
          previousPage = page;
        });

        pagination.appendChild(makeButton('›', {
          disabled: currentPage === pages,
          ariaLabel: 'Page suivante',
          onClick: () => {
            currentPage += 1;
            render();
            root.querySelector('[data-mvr-list]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }));
      };

      const render = () => {
        const matches = filteredReviews();
        const pages = Math.max(1, Math.ceil(matches.length / pageSize));
        currentPage = Math.min(currentPage, pages);
        const start = (currentPage - 1) * pageSize;
        const visible = new Set(matches.slice(start, start + pageSize));

        reviews.forEach((review) => {
          review.hidden = !visible.has(review);
        });

        if (emptyState) emptyState.hidden = matches.length !== 0;
        if (resultCount) resultCount.textContent = `${matches.length} ${matches.length === 1 ? displayedSingular : displayedPlural}`;
        renderPagination(matches.length ? pages : 0);
      };

      if (search) {
        search.addEventListener('input', (event) => {
          query = event.target.value.trim();
          currentPage = 1;
          render();
        });
      }

      ratingButtons.forEach((button) => {
        button.addEventListener('click', () => {
          activeRating = button.dataset.mvrRating || 'all';
          currentPage = 1;
          ratingButtons.forEach((item) => {
            const isActive = item === button;
            item.classList.toggle('is-active', isActive);
            item.setAttribute('aria-pressed', String(isActive));
          });
          render();
        });
      });

      root.querySelectorAll('a[href^="#mvr-"], a[href^="#mirabel-reviews-list-"]').forEach((anchor) => {
        anchor.addEventListener('click', (event) => {
          const target = root.querySelector(anchor.getAttribute('href'));
          if (!target) return;
          event.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      render();
    };

    document.querySelectorAll('[data-mvr-root]').forEach(initMirabelReviews);

    document.addEventListener('shopify:section:load', (event) => {
      const root = event.target.matches?.('[data-mvr-root]')
        ? event.target
        : event.target.querySelector?.('[data-mvr-root]');
      initMirabelReviews(root);
    });
  })();
</script>

