              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4c.5 2.2 1.8 3.5 4 4v4c-1.6 0-3-.5-4-1.3V16a6 6 0 1 1-6-6h1v4H9a2 2 0 1 0 2 2V4h4Z"/></svg>
