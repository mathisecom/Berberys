{% comment %}
  Section Shopify autonome — Avis clients Mirabel
  Installation : Boutique en ligne > Thèmes > Modifier le code > Sections
  Créez « mirabel-avis-clients.liquid », collez ce fichier, puis ajoutez la section dans l’éditeur.

  Important : activez « Acheteur vérifié » uniquement pour une commande réellement contrôlée.
{% endcomment %}

{%- liquid
  assign review_count = 0
  assign rating_sum = 0
  assign rating_5_count = 0
  assign rating_4_count = 0
  assign rating_3_count = 0
  assign rating_2_count = 0
  assign rating_1_count = 0

  for block in section.blocks
    if block.type == 'review'
      assign review_count = review_count | plus: 1
      assign block_rating = block.settings.rating | plus: 0
      assign rating_sum = rating_sum | plus: block_rating

      if block_rating == 5
        assign rating_5_count = rating_5_count | plus: 1
      elsif block_rating == 4
        assign rating_4_count = rating_4_count | plus: 1
      elsif block_rating == 3
        assign rating_3_count = rating_3_count | plus: 1
      elsif block_rating == 2
        assign rating_2_count = rating_2_count | plus: 1
      else
        assign rating_1_count = rating_1_count | plus: 1
      endif
    endif
  endfor

  if section.settings.stats_mode == 'manual'
    assign overall_rating = section.settings.manual_rating | plus: 0
    assign displayed_total = section.settings.manual_total | plus: 0
    assign rating_5_percent = section.settings.manual_5_percent
    assign rating_4_percent = section.settings.manual_4_percent
    assign rating_3_percent = section.settings.manual_3_percent
    assign rating_2_percent = section.settings.manual_2_percent
    assign rating_1_percent = section.settings.manual_1_percent
  elsif review_count > 0
    assign overall_rating = rating_sum | times: 1.0 | divided_by: review_count | round: 1
    assign displayed_total = review_count
    assign rating_5_percent = rating_5_count | times: 100 | divided_by: review_count
    assign rating_4_percent = rating_4_count | times: 100 | divided_by: review_count
    assign rating_3_percent = rating_3_count | times: 100 | divided_by: review_count
    assign rating_2_percent = rating_2_count | times: 100 | divided_by: review_count
    assign rating_1_percent = rating_1_count | times: 100 | divided_by: review_count
  else
    assign overall_rating = 0
    assign displayed_total = 0
    assign rating_5_percent = 0
    assign rating_4_percent = 0
    assign rating_3_percent = 0
    assign rating_2_percent = 0
    assign rating_1_percent = 0
  endif

  assign product_link = section.settings.product_link
  if product_link == blank
    assign product_link = '#mirabel-reviews-list-' | append: section.id
  endif

  assign review_form_link = section.settings.review_form_link
  if review_form_link == blank
    assign review_form_link = '#mirabel-reviews-list-' | append: section.id
  endif

  assign overall_rating_percent = overall_rating | times: 20

  assign ui_tab_overview = 'Aperçu'
  assign ui_tab_reviews = 'Avis'
  assign ui_tab_about = 'À propos'
  assign ui_view_reviews = 'Voir les avis'
  assign ui_score_prefix = 'Basé sur'
  assign ui_search_label = 'Rechercher un mot-clé'
  assign ui_search_placeholder = 'Rechercher'
  assign ui_filters_label = 'Notes :'
  assign ui_all_ratings = 'Toutes'
  assign ui_reviews_list_title = 'Les avis clients'
  assign ui_order_label = 'Ordre de la section'
  assign ui_displayed_singular = 'avis affiché'
  assign ui_displayed_plural = 'avis affichés'
  assign ui_experience_label = 'Expérience du :'
  assign ui_response_prefix = 'Réponse de'
  assign ui_empty_text = 'Aucun avis ne correspond à votre recherche.'
  assign ui_chronology_text = 'Avis affichés selon l’ordre défini dans l’éditeur Shopify.'
  assign ui_about_title = 'À propos de Mirabel'

  for block in section.blocks
    if block.type == 'interface_texts'
      assign ui_tab_overview = block.settings.tab_overview | default: ui_tab_overview
      assign ui_tab_reviews = block.settings.tab_reviews | default: ui_tab_reviews
      assign ui_tab_about = block.settings.tab_about | default: ui_tab_about
      assign ui_view_reviews = block.settings.view_reviews | default: ui_view_reviews
      assign ui_score_prefix = block.settings.score_prefix | default: ui_score_prefix
      assign ui_search_label = block.settings.search_label | default: ui_search_label
      assign ui_search_placeholder = block.settings.search_placeholder | default: ui_search_placeholder
      assign ui_filters_label = block.settings.filters_label | default: ui_filters_label
      assign ui_all_ratings = block.settings.all_ratings | default: ui_all_ratings
      assign ui_reviews_list_title = block.settings.reviews_list_title | default: ui_reviews_list_title
      assign ui_order_label = block.settings.order_label | default: ui_order_label
      assign ui_displayed_singular = block.settings.displayed_singular | default: ui_displayed_singular
      assign ui_displayed_plural = block.settings.displayed_plural | default: ui_displayed_plural
      assign ui_experience_label = block.settings.experience_label | default: ui_experience_label
      assign ui_response_prefix = block.settings.response_prefix | default: ui_response_prefix
      assign ui_empty_text = block.settings.empty_text | default: ui_empty_text
      assign ui_chronology_text = block.settings.chronology_text | default: ui_chronology_text
      assign ui_about_title = block.settings.about_title | default: ui_about_title
      break
    endif
  endfor
-%}

<section
  id="MirabelReviews-{{ section.id }}"
  class="mvr"
  data-mvr-root
  data-page-size="{{ section.settings.reviews_per_page }}"
  data-displayed-singular="{{ ui_displayed_singular | escape }}"
  data-displayed-plural="{{ ui_displayed_plural | escape }}"
  style="
    --mvr-primary: {{ section.settings.primary_color }};
    --mvr-primary-soft: {{ section.settings.primary_soft_color }};
    --mvr-text: {{ section.settings.text_color }};
    --mvr-muted: {{ section.settings.muted_color }};
    --mvr-border: {{ section.settings.border_color }};
    --mvr-card: {{ section.settings.card_color }};
    --mvr-background: {{ section.settings.background_color }};
    --mvr-success: {{ section.settings.success_color }};
    --mvr-header-bg: {{ section.settings.header_background_color }};
    --mvr-header-text: {{ section.settings.header_text_color }};
    --mvr-header-height: {{ section.settings.header_height }}px;
    --mvr-radius: {{ section.settings.corner_radius }}px;
    --mvr-max-width: {{ section.settings.max_width }}px;
    --mvr-pad-top: {{ section.settings.padding_top }}px;
    --mvr-pad-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  {%- if section.settings.show_top_header -%}
    <div class="mvr__top-header">
      <div class="mvr__top-header-inner">
        <a class="mvr__top-logo" href="{{ section.settings.header_logo_link | default: product_link }}" aria-label="{{ section.settings.header_logo_alt | default: section.settings.brand_name | escape }}">
          {%- if section.settings.header_logo != blank -%}
            {{ section.settings.header_logo
              | image_url: width: 700
              | image_tag:
                class: 'mvr__top-logo-image',
                widths: '120, 180, 240, 320, 480, 700',
                sizes: '(max-width: 680px) 150px, 210px',
                loading: 'lazy',
                alt: section.settings.header_logo_alt
            }}
          {%- else -%}
            <span class="mvr__top-monogram" aria-hidden="true">{{ section.settings.header_monogram | default: 'M' | escape }}</span>
            <span class="mvr__top-wordmark">
              <strong>{{ section.settings.header_title | default: section.settings.brand_name }}</strong>
              {%- if section.settings.header_subtitle != blank -%}
                <span>{{ section.settings.header_subtitle }}</span>
              {%- endif -%}
            </span>
          {%- endif -%}
        </a>

        {%- if section.settings.show_header_links -%}
          <nav class="mvr__top-links" aria-label="Navigation Mirabel">
            {%- if section.settings.header_link_1_label != blank -%}
              <a href="{{ section.settings.header_link_1_url | default: product_link }}">{{ section.settings.header_link_1_label }}</a>
            {%- endif -%}
            {%- if section.settings.header_link_2_label != blank -%}
              <a href="{{ section.settings.header_link_2_url | default: product_link }}">{{ section.settings.header_link_2_label }}</a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="mvr__shell">
    <header class="mvr__brandbar">
      <a class="mvr__brand" href="#mvr-overview-{{ section.id }}" aria-label="Voir l’aperçu des avis {{ section.settings.brand_name }}">
        <span class="mvr__brand-name">{{ section.settings.brand_name }}</span>
        <span class="mvr__brand-score">{{ overall_rating }}</span>
        <span class="mvr__brand-star" aria-hidden="true">★</span>
      </a>

      {%- if section.settings.show_product_button -%}
        <a class="mvr__outline-button" href="{{ product_link }}">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M14 4h6v6M20 4l-9 9M18 13v6a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h6" />
          </svg>
          {{ section.settings.product_button_label }}
        </a>
      {%- endif -%}
    </header>

    {%- if section.settings.show_tabs -%}
      <nav class="mvr__tabs" aria-label="Navigation des avis">
        <a class="mvr__tab" href="#mvr-overview-{{ section.id }}">{{ ui_tab_overview }}</a>
        <a class="mvr__tab mvr__tab--active" href="#mirabel-reviews-list-{{ section.id }}">{{ ui_tab_reviews }}</a>
        <a class="mvr__tab" href="#mvr-about-{{ section.id }}">{{ ui_tab_about }}</a>
      </nav>
    {%- endif -%}

    <div id="mvr-overview-{{ section.id }}" class="mvr__content">
      <div class="mvr__intro">
        <div class="mvr__intro-copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="mvr__eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2 class="mvr__heading">{{ section.settings.heading }}</h2>
          {%- if section.settings.tagline != blank -%}
            <p class="mvr__tagline">{{ section.settings.tagline }}</p>
          {%- endif -%}
        </div>

        <div class="mvr__intro-rating" aria-label="Note moyenne : {{ overall_rating }} sur 5">
          <strong>{{ overall_rating }}</strong>
          <div class="mvr-stars mvr-stars--large" style="--mvr-rating-width: {{ overall_rating_percent }}%;" aria-hidden="true">
            <span class="mvr-stars__base">★★★★★</span>
            <span class="mvr-stars__fill">★★★★★</span>
          </div>
          <a href="#mirabel-reviews-list-{{ section.id }}">{{ ui_view_reviews }}</a>
        </div>
      </div>

      <div class="mvr__section-title-row">
        <div>
          <h3>{{ section.settings.reviews_heading }}</h3>
          <p>
            {{ displayed_total }}
            {%- if displayed_total > 1 -%} avis{%- else -%} avis{%- endif -%}
            {%- if section.settings.reviews_period != blank -%} {{ section.settings.reviews_period }}{%- endif -%}
          </p>
        </div>
      </div>

      {%- if section.settings.show_transparency_notice -%}
        <div class="mvr__notice">
          <span class="mvr__notice-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M12 3l7 3v5c0 4.6-2.9 8.2-7 10-4.1-1.8-7-5.4-7-10V6l7-3Z"/><path d="m9 12 2 2 4-4"/></svg>
          </span>
          <div>
            <strong>{{ section.settings.transparency_title }}</strong>
            <p>{{ section.settings.transparency_text }}</p>
          </div>
        </div>
      {%- endif -%}

      <div class="mvr__layout">
        <aside class="mvr__score-card" aria-label="Répartition des notes">
          <div class="mvr__score-main">
            <strong>{{ overall_rating }}</strong>
            <span aria-hidden="true">★</span>
          </div>
          <p class="mvr__score-caption">
            {{ ui_score_prefix }} {{ displayed_total }}
            {%- if displayed_total > 1 -%} avis{%- else -%} avis{%- endif -%}
          </p>

          <div class="mvr__distribution">
            {%- assign distribution_labels = '5,4,3,2,1' | split: ',' -%}
            {%- for label in distribution_labels -%}
              {%- case label -%}
                {%- when '5' -%}{%- assign percent = rating_5_percent -%}
                {%- when '4' -%}{%- assign percent = rating_4_percent -%}
                {%- when '3' -%}{%- assign percent = rating_3_percent -%}
                {%- when '2' -%}{%- assign percent = rating_2_percent -%}
                {%- else -%}{%- assign percent = rating_1_percent -%}
              {%- endcase -%}
              <div class="mvr__distribution-row">
                <span>{{ label }}</span>
                <span class="mvr__bar" aria-hidden="true"><span style="width: {{ percent }}%;"></span></span>
                <strong>{{ percent }}%</strong>
              </div>
            {%- endfor -%}
          </div>

          {%- if section.settings.show_search -%}
            <label class="mvr__search-label" for="MvrSearch-{{ section.id }}">{{ ui_search_label }}</label>
            <div class="mvr__search">
              <input
                id="MvrSearch-{{ section.id }}"
                type="search"
                placeholder="{{ ui_search_placeholder | escape }}"
                autocomplete="off"
                data-mvr-search
              >
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-4-4"/></svg>
            </div>
          {%- endif -%}

          {%- if section.settings.show_rating_filters -%}
            <fieldset class="mvr__filters">
              <legend>{{ ui_filters_label }}</legend>
              <div class="mvr__filter-buttons">
                <button type="button" class="is-active" data-mvr-rating="all" aria-pressed="true">{{ ui_all_ratings }}</button>
                {%- for i in (1..5) -%}
                  <button type="button" data-mvr-rating="{{ i }}" aria-pressed="false">{{ i }} <span aria-hidden="true">★</span></button>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endif -%}
        </aside>

        <div class="mvr__reviews-column">
          {%- if section.settings.show_summary -%}
            <div class="mvr__summary-card">
              <div class="mvr__summary-icon" aria-hidden="true">✦</div>
              <div>
                <h3>{{ section.settings.summary_title }}</h3>
                <p>{{ section.settings.summary_text }}</p>
                {%- if section.settings.summary_note != blank -%}
                  <small>{{ section.settings.summary_note }}</small>
                {%- endif -%}
              </div>
            </div>
          {%- endif -%}

          {%- if section.settings.show_review_button -%}
            <a class="mvr__review-button" href="{{ review_form_link }}">
              {{ section.settings.review_button_label }}
            </a>
          {%- endif -%}

          <div id="mirabel-reviews-list-{{ section.id }}" class="mvr__list-heading">
            <div>
              <h3>{{ ui_reviews_list_title }}</h3>
              <p data-mvr-results-count>
                {{ review_count }}
                {% if review_count == 1 %}{{ ui_displayed_singular }}{% else %}{{ ui_displayed_plural }}{% endif %}
              </p>
            </div>
            <span>{{ ui_order_label }}</span>
          </div>

          <div class="mvr__reviews-list" data-mvr-list>
            {%- for block in section.blocks -%}
              {%- if block.type == 'review' -%}
                {%- assign review_rating = block.settings.rating | plus: 0 -%}
                <article
                  class="mvr-review"
                  data-mvr-review
                  data-rating="{{ review_rating }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="mvr-review__top">
                    <div>
                      <h4>{{ block.settings.author | default: 'Client Mirabel' }}</h4>
                      <div class="mvr-review__meta">
                        <span class="mvr-review__stars" aria-label="{{ review_rating }} sur 5">
                          {%- for i in (1..5) -%}
                            <span class="{% if i <= review_rating %}is-filled{% endif %}" aria-hidden="true">★</span>
                          {%- endfor -%}
                        </span>
                        {%- if block.settings.date != blank -%}
                          <time>{{ block.settings.date }}</time>
                        {%- endif -%}
                      </div>
                    </div>

                    {%- if block.settings.verified -%}
                      <span class="mvr-review__verified">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="m8.5 12 2.2 2.2 4.8-5"/></svg>
                        {{ section.settings.verified_label }}
                      </span>
                    {%- endif -%}
                  </div>

                  {%- if block.settings.headline != blank -%}
                    <h5>{{ block.settings.headline }}</h5>
                  {%- endif -%}

                  {%- if block.settings.text != blank -%}
                    <div class="mvr-review__text">{{ block.settings.text | newline_to_br }}</div>
                  {%- endif -%}

                  {%- if block.settings.experience_date != blank -%}
                    <p class="mvr-review__experience">{{ ui_experience_label }} <strong>{{ block.settings.experience_date }}</strong></p>
                  {%- endif -%}

                  {%- if block.settings.response != blank -%}
                    <div class="mvr-review__response">
                      <strong>{{ ui_response_prefix }} {{ section.settings.brand_name }}</strong>
                      {{ block.settings.response }}
                    </div>
                  {%- endif -%}
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>

          <div class="mvr__empty" data-mvr-empty hidden>
            {{ ui_empty_text }}
          </div>

          <nav class="mvr__pagination" aria-label="Pagination des avis" data-mvr-pagination></nav>
          <p class="mvr__chronology">{{ ui_chronology_text }}</p>
        </div>
      </div>

      {%- if section.settings.show_about -%}
        <section id="mvr-about-{{ section.id }}" class="mvr__about">
          <h3>{{ ui_about_title }}</h3>
          <strong>{{ section.settings.product_name }}</strong>
          <p>{{ section.settings.about_text }}</p>

          {%- if section.settings.show_about_button -%}
            <a class="mvr__outline-button" href="{{ product_link }}">
              {{ section.settings.about_button_label }}
            </a>
          {%- endif -%}
        </section>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #MirabelReviews-{{ section.id }} {
    background: var(--mvr-background);
    color: var(--mvr-text);
    padding: 0 0 var(--mvr-pad-bottom);
    font-family: var(--font-body-family, Arial, sans-serif);
  }

  #MirabelReviews-{{ section.id }} * { box-sizing: border-box; }
  #MirabelReviews-{{ section.id }} a { color: inherit; }
  #MirabelReviews-{{ section.id }} button,
  #MirabelReviews-{{ section.id }} input { font: inherit; }

  #MirabelReviews-{{ section.id }} .mvr__top-header {
    width: 100%;
    min-height: var(--mvr-header-height);
    display: flex;
    align-items: center;
    background: var(--mvr-header-bg);
    color: var(--mvr-header-text);
  }

  #MirabelReviews-{{ section.id }} .mvr__top-header-inner {
    width: min(calc(100% - 32px), var(--mvr-max-width));
    min-height: var(--mvr-header-height);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
  }

  #MirabelReviews-{{ section.id }} .mvr__top-logo {
    display: inline-flex;
    align-items: center;
    gap: 13px;
    color: var(--mvr-header-text);
    text-decoration: none;
    line-height: 1;
  }

  #MirabelReviews-{{ section.id }} .mvr__top-logo-image {
    display: block;
    width: auto;
    max-width: {{ section.settings.header_logo_width }}px;
    max-height: calc(var(--mvr-header-height) - 24px);
    object-fit: contain;
  }

  #MirabelReviews-{{ section.id }} .mvr__top-monogram {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    border: 3px solid currentColor;
    border-radius: 50%;
    font-size: 24px;
    font-weight: 900;
  }

  #MirabelReviews-{{ section.id }} .mvr__top-wordmark {
    display: grid;
    gap: 3px;
  }

  #MirabelReviews-{{ section.id }} .mvr__top-wordmark strong {
    font-size: clamp(24px, 2.2vw, 34px);
    font-weight: 900;
    letter-spacing: -.04em;
  }

  #MirabelReviews-{{ section.id }} .mvr__top-wordmark span {
    font-size: 13px;
    font-weight: 700;
    opacity: .9;
  }

  #MirabelReviews-{{ section.id }} .mvr__top-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(24px, 4vw, 52px);
  }

  #MirabelReviews-{{ section.id }} .mvr__top-links a {
    color: var(--mvr-header-text);
    text-decoration: none;
    font-size: clamp(15px, 1.4vw, 20px);
    font-weight: 800;
    white-space: nowrap;
  }

  #MirabelReviews-{{ section.id }} .mvr__top-links a:hover {
    text-decoration: underline;
    text-underline-offset: 5px;
  }

  #MirabelReviews-{{ section.id }} .mvr__shell {
    width: min(calc(100% - 32px), var(--mvr-max-width));
    margin: 0 auto;
    padding-top: var(--mvr-pad-top);
  }

  #MirabelReviews-{{ section.id }} .mvr__brandbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 18px 0;
    border-bottom: 1px solid var(--mvr-border);
  }

  #MirabelReviews-{{ section.id }} .mvr__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 800;
    font-size: clamp(20px, 2vw, 26px);
  }

  #MirabelReviews-{{ section.id }} .mvr__brand-score { font-size: .82em; }
  #MirabelReviews-{{ section.id }} .mvr__brand-star { color: var(--mvr-primary); }

  #MirabelReviews-{{ section.id }} .mvr__outline-button {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 10px 16px;
    border: 1.5px solid var(--mvr-primary);
    border-radius: 7px;
    color: var(--mvr-primary);
    background: transparent;
    font-weight: 750;
    text-decoration: none;
    transition: background .2s ease, color .2s ease, transform .2s ease;
  }

  #MirabelReviews-{{ section.id }} .mvr__outline-button:hover {
    color: #fff;
    background: var(--mvr-primary);
    transform: translateY(-1px);
  }

  #MirabelReviews-{{ section.id }} .mvr__outline-button svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  #MirabelReviews-{{ section.id }} .mvr__tabs {
    display: flex;
    align-items: center;
    gap: 26px;
    min-height: 58px;
    border-bottom: 1px solid var(--mvr-border);
  }

  #MirabelReviews-{{ section.id }} .mvr__tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    align-self: stretch;
    color: var(--mvr-text);
    text-decoration: none;
    font-weight: 650;
  }

  #MirabelReviews-{{ section.id }} .mvr__tab--active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
