              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 9h4v11H5V9Zm2-5a2 2 0 1 1 0 4 2 2 0 0 1 0-4Zm4 5h4v1.5c.8-1.2 2-2 4-2 3 0 5 2 5 6V20h-4v-5c0-2-.7-3-2.2-3-1.7 0-2.8 1.1-2.8 3.4V20h-4V9Z"/></svg>
            </a>
          </nav>
        </div>

        {%- if section.settings.cookie_label != blank -%}
          <a class="mvr-footer__cookies" href="{{ section.settings.cookie_url | default: routes.root_url }}">
