{%- liquid
  assign section_id = section.id
  assign bg_color = section.settings.bg_color
  assign text_color = section.settings.text_color
  assign heading_color = section.settings.heading_color
  assign bullet_color = section.settings.bullet_color
  assign image_position = section.settings.image_position
  assign image_radius = section.settings.image_radius
  assign heading_size = section.settings.heading_size
  assign body_size = section.settings.body_size
  assign content_max_width = section.settings.content_max_width
  assign section_padding_top = section.settings.padding_top
  assign section_padding_bottom = section.settings.padding_bottom
  assign heading_font = section.settings.heading_font
  assign body_font = section.settings.body_font
  assign heading_font_bold = heading_font | font_modify: 'weight', 'bolder'
  assign body_font_bold = body_font | font_modify: 'weight', 'bolder'
-%}

<style>
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ heading_font_bold | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}
  {{ body_font_bold | font_face: font_display: 'swap' }}

  .pbenefits-{{ section_id }} {
    background-color: {{ bg_color }};
    color: {{ text_color }};
    padding: {{ section_padding_top }}px 20px {{ section_padding_bottom }}px;
    font-family: {{ body_font.family }}, {{ body_font.fallback_families }};
    font-style: {{ body_font.style }};
    font-weight: {{ body_font.weight }};
    overflow: hidden;
  }

  .pbenefits-{{ section_id }} .pbenefits__container {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }

  {% if image_position == 'left' %}
  .pbenefits-{{ section_id }} .pbenefits__container {
    direction: rtl;
  }
  .pbenefits-{{ section_id }} .pbenefits__content,
  .pbenefits-{{ section_id }} .pbenefits__media {
    direction: ltr;
  }
  {% endif %}

  .pbenefits-{{ section_id }} .pbenefits__content {
    max-width: {{ content_max_width }}px;
  }

  .pbenefits-{{ section_id }} .pbenefits__heading {
    font-family: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    font-style: {{ heading_font.style }};
    font-size: {{ heading_size }}px;
    line-height: 1.25;
    font-weight: 700;
    color: {{ heading_color }};
    margin: 0 0 24px;
    letter-spacing: -0.01em;
  }

  .pbenefits-{{ section_id }} .pbenefits__intro {
    font-size: {{ body_size }}px;
    line-height: 1.6;
    color: {{ text_color }};
    margin: 0 0 28px;
  }

  .pbenefits-{{ section_id }} .pbenefits__intro strong,
  .pbenefits-{{ section_id }} .pbenefits__bullet strong {
    font-weight: 700;
    color: {{ text_color }};
  }

  .pbenefits-{{ section_id }} .pbenefits__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pbenefits-{{ section_id }} .pbenefits__list li {
    position: relative;
    padding-left: 22px;
    margin-bottom: 14px;
    font-size: {{ body_size }}px;
    line-height: 1.55;
    color: {{ text_color }};
  }

  .pbenefits-{{ section_id }} .pbenefits__list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 8px;
    height: 8px;
    background-color: {{ bullet_color }};
  }

  .pbenefits-{{ section_id }} .pbenefits__media {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pbenefits-{{ section_id }} .pbenefits__media img {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: {{ image_radius }}px;
  }

  /* Tablet */
  @media (max-width: 990px) {
    .pbenefits-{{ section_id }} .pbenefits__container {
      gap: 48px;
    }
    .pbenefits-{{ section_id }} .pbenefits__heading {
      font-size: {{ heading_size | times: 0.85 | round }}px;
    }
  }

  /* Mobile */
  @media (max-width: 749px) {
    .pbenefits-{{ section_id }} {
      padding: {{ section_padding_top | times: 0.6 | round }}px 20px {{ section_padding_bottom | times: 0.6 | round }}px;
    }
    .pbenefits-{{ section_id }} .pbenefits__container {
      grid-template-columns: 1fr;
      gap: 28px;
      direction: ltr;
    }
    .pbenefits-{{ section_id }} .pbenefits__media {
      order: -1;
    }
    .pbenefits-{{ section_id }} .pbenefits__content {
      max-width: 100%;
    }
    .pbenefits-{{ section_id }} .pbenefits__heading {
      font-size: {{ heading_size | times: 0.7 | round }}px;
    }
  }
</style>

<section class="pbenefits-{{ section_id }}">
  <div class="pbenefits__container">
    <div class="pbenefits__content">
      {%- if section.settings.heading != blank -%}
        <h2 class="pbenefits__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.settings.intro_text != blank -%}
        <div class="pbenefits__intro">{{ section.settings.intro_text }}</div>
      {%- endif -%}

      {%- assign bullet_blocks = section.blocks | where: 'type', 'bullet' -%}
      {%- if bullet_blocks.size > 0 -%}
        <ul class="pbenefits__list">
          {%- for block in bullet_blocks -%}
            <li class="pbenefits__bullet" {{ block.shopify_attributes }}>
              {{ block.settings.text }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="pbenefits__media">
      {%- if section.settings.product_image != blank -%}
        {{ section.settings.product_image | image_url: width: 1200 | image_tag:
          loading: 'lazy',
          widths: '400, 600, 800, 1000, 1200',
          sizes: '(max-width: 749px) 100vw, 50vw',
          alt: section.settings.heading | default: 'Product image'
        }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Benefits",
  "tag": "section",
  "class": "section-product-benefits",
  "settings": [
    {
      "type": "header",
      "content": "Contenu"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Un actif puissant pour l'équilibre métabolique"
    },
    {
      "type": "richtext",
      "id": "intro_text",
      "label": "Paragraphe d'introduction",
      "info": "Utilisez le gras pour mettre en avant des passages clés",
      "default": "<p>Utilisé depuis des siècles dans la médecine traditionnelle chinoise, la berbérine est reconnue pour <strong>ses effets sur la glycémie et le stockage des graisses.</strong> Elle agit en effet en stimulant l'AMPK, une enzyme clé dans la gestion de l'énergie et du métabolisme. Une prise de Berbérine vous aidera ainsi à :</p>"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "product_image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Position de l'image (desktop)",
      "options": [
        { "value": "right", "label": "À droite" },
        { "value": "left", "label": "À gauche" }
      ],
      "default": "right"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Arrondi des coins (px)",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 20
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Couleur du titre",
      "default": "#6B8E7F"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#1F1F1F"
    },
    {
      "type": "color",
      "id": "bullet_color",
      "label": "Couleur des puces",
      "default": "#1F1F1F"
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Police du titre",
      "default": "manrope_n7"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Police du corps de texte",
      "default": "dm_sans_n4"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Taille du titre (px)",
      "min": 20,
      "max": 56,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Taille du texte (px)",
      "min": 12,
      "max": 22,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "content_max_width",
      "label": "Largeur max contenu (px)",
      "min": 400,
      "max": 700,
      "step": 10,
      "default": 560
    },
    {
      "type": "header",
      "content": "Espacement"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Marge haute (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Marge basse (px)",
      "min": 0,
      "max": 200,
      "step": 4,
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "bullet",
      "name": "Puce",
      "limit": 10,
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Texte de la puce",
          "info": "Utilisez le gras pour mettre en avant",
          "default": "<p><strong>Maintenir une glycémie stable</strong> en favorisant l'absorption du glucose par l'organisme.</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Benefits",
      "blocks": [
        {
          "type": "bullet",
          "settings": {
            "text": "<p><strong>Maintenir une glycémie stable</strong> en favorisant l'absorption du glucose par l'organisme,</p>"
          }
        },
        {
          "type": "bullet",
          "settings": {
            "text": "<p>Améliorer la sensibilité à l'insuline et <strong>réduire les pics de sucre dans le sang.</strong></p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}