</style>

<script>
  (() => {
    const section = document.querySelector('.section-{{ section.id }}');
    if (!section || section.dataset.reviewsReady === 'true') return;
    section.dataset.reviewsReady = 'true';

    const reviews = Array.from(section.querySelectorAll('[data-review-item]'));
    const pagination = section.querySelector('[data-reviews-pagination]');
    const counter = section.querySelector('[data-reviews-counter]');
    const numbers = section.querySelector('[data-page-numbers]');
    const prev = section.querySelector('[data-page-prev]');
    const next = section.querySelector('[data-page-next]');
    const perPage = {{ section.settings.reviews_per_page | default: 10 }};

    if (!pagination || !numbers || reviews.length <= perPage) {
      if (pagination) pagination.hidden = true;
      reviews.forEach((review) => review.hidden = false);
      if (counter && reviews.length > 0) {
        counter.textContent = `Affichage de 1–${reviews.length} sur ${reviews.length} avis`;
      }
      return;
    }

    const totalPages = Math.ceil(reviews.length / perPage);
    let currentPage = 1;

    const visiblePages = () => {
      if (totalPages <= 7) return Array.from({ length: totalPages }, (_, i) => i + 1);
      const pages = [1];
      const from = Math.max(2, currentPage - 1);
      const to = Math.min(totalPages - 1, currentPage + 1);
      if (from > 2) pages.push('ellipsis-start');
      for (let page = from; page <= to; page += 1) pages.push(page);
      if (to < totalPages - 1) pages.push('ellipsis-end');
      pages.push(totalPages);
      return pages;
    };

    const renderNumbers = () => {
      numbers.innerHTML = '';
      visiblePages().forEach((value) => {
        if (typeof value !== 'number') {
          const ellipsis = document.createElement('span');
          ellipsis.className = 'product-reviews__page-ellipsis';
          ellipsis.textContent = '…';
          ellipsis.setAttribute('aria-hidden', 'true');
          numbers.appendChild(ellipsis);
          return;
        }

        const button = document.createElement('button');
        button.type = 'button';
        button.className = `product-reviews__page${value === currentPage ? ' is-active' : ''}`;
        button.textContent = value;
        button.setAttribute('aria-label', `Afficher la page ${value}`);
        if (value === currentPage) button.setAttribute('aria-current', 'page');
        button.addEventListener('click', () => showPage(value, true));
        numbers.appendChild(button);
      });
    };

    const showPage = (page, scrollToTop = false) => {
      currentPage = Math.min(Math.max(page, 1), totalPages);
      const start = (currentPage - 1) * perPage;
      const end = start + perPage;

      reviews.forEach((review, index) => {
        review.hidden = index < start || index >= end;
      });

      prev.disabled = currentPage === 1;
      next.disabled = currentPage === totalPages;
      if (counter) {
        const visibleEnd = Math.min(end, reviews.length);
        counter.textContent = `Affichage de ${start + 1}–${visibleEnd} sur ${reviews.length} avis`;
      }
      renderNumbers();

      if (scrollToTop) {
        section.querySelector('[data-reviews-list]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    };

    prev.addEventListener('click', () => showPage(currentPage - 1, true));
    next.addEventListener('click', () => showPage(currentPage + 1, true));
    pagination.hidden = false;
    showPage(1);
  })();
</script>

