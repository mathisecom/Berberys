    }

    .section-{{ section.id }} .product-reviews__title {
      line-height: 1.25;
    }

    .section-{{ section.id }} .product-reviews__rating-line {
      flex-wrap: wrap;
      gap: 8px;
    }

    .section-{{ section.id }} .product-reviews__review-head {
