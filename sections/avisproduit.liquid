{% comment %}
  Section : Avis produit custom
  Fonts : Manrope + DM Sans
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<section
  class="product-reviews section-{{ section.id }}"
  style="
    --section-bg: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --muted-color: {{ section.settings.muted_text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --line-color: {{ section.settings.line_color }};
    --verified-color: {{ section.settings.verified_color }};
    --pagination-bg: {{ section.settings.pagination_background }};
    --pagination-text: {{ section.settings.pagination_text_color }};

    --max-width: {{ section.settings.max_width }}px;

    --padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    --title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --rating-size-desktop: {{ section.settings.rating_size_desktop }}px;
    --rating-size-mobile: {{ section.settings.rating_size_mobile }}px;
    --stars-size: {{ section.settings.stars_size }}px;
    --summary-size: {{ section.settings.summary_size }}px;
    --verified-reviews-logo-width: {{ section.settings.verified_reviews_logo_width }}px;
    --name-size: {{ section.settings.name_size }}px;
    --verified-size: {{ section.settings.verified_size }}px;
    --review-title-size: {{ section.settings.review_title_size }}px;
    --review-text-size: {{ section.settings.review_text_size }}px;
    --date-size: {{ section.settings.date_size }}px;

    --title-bottom-space: {{ section.settings.title_bottom_space }}px;
    --summary-bottom-space: {{ section.settings.summary_bottom_space }}px;
    --review-padding-y: {{ section.settings.review_padding_y }}px;

    --footer-bg: {{ section.settings.footer_background_color }};
    --footer-text: {{ section.settings.footer_text_color }};
    --footer-muted: {{ section.settings.footer_muted_color }};
    --footer-icon-bg: {{ section.settings.footer_icon_background }};
    --footer-icon-color: {{ section.settings.footer_icon_color }};
  "
>
  <div class="product-reviews__inner">

    {% assign show_verified_source = false %}
    {% if section.settings.show_verified_reviews %}
      {% if section.settings.verified_reviews_logo != blank %}
        {% assign show_verified_source = true %}
      {% elsif section.settings.verified_reviews_link_text != blank and section.settings.verified_reviews_url != blank %}
        {% assign show_verified_source = true %}
      {% endif %}
    {% endif %}

    {% if section.settings.title != blank %}
      <div class="product-reviews__title-wrapper">
        <h2 class="product-reviews__title">
          {{ section.settings.title }}
        </h2>
      </div>
    {% endif %}

    {% if show_verified_source %}
        <div class="product-reviews__verified-source">
          {% if section.settings.verified_reviews_logo != blank %}
            {% if section.settings.verified_reviews_url != blank %}
              <a
                class="product-reviews__verified-logo-link"
                href="{{ section.settings.verified_reviews_url }}"
                {% if section.settings.verified_reviews_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                aria-label="Consulter tous les avis clients"
              >
            {% endif %}

            <img
              class="product-reviews__verified-logo"
              src="{{ section.settings.verified_reviews_logo | image_url: width: 500 }}"
              alt="{{ section.settings.verified_reviews_logo_alt | escape }}"
              width="{{ section.settings.verified_reviews_logo_width }}"
              loading="lazy"
            >

            {% if section.settings.verified_reviews_url != blank %}
              </a>
            {% endif %}
          {% endif %}

          {% if section.settings.verified_reviews_link_text != blank and section.settings.verified_reviews_url != blank %}
            <a
              class="product-reviews__verified-link"
              href="{{ section.settings.verified_reviews_url }}"
              {% if section.settings.verified_reviews_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ section.settings.verified_reviews_link_text }}
            </a>
          {% endif %}
        </div>
    {% endif %}

    <div class="product-reviews__summary{% unless show_verified_source %} product-reviews__summary--without-verified-source{% endunless %}">
      <div class="product-reviews__rating-line">
        {% if section.settings.rating != blank %}
          <span class="product-reviews__rating">
            {{ section.settings.rating }}
          </span>
        {% endif %}

        {% if section.settings.stars != blank %}
          <span class="product-reviews__stars">
            {{ section.settings.stars }}
          </span>
        {% endif %}
      </div>

      {% if section.settings.based_text != blank %}
        <div class="product-reviews__based">
          {{ section.settings.based_text }}
        </div>
      {% endif %}
    </div>

    <div class="product-reviews__list" data-reviews-list>
      <article class="product-reviews__item" data-review-item>
        <div class="product-reviews__author">
          <div class="product-reviews__name">Marie D.</div>
          <div class="product-reviews__verified">
            <span class="product-reviews__verified-icon">✓</span>
            Acheteur vérifié
          </div>
        </div>

