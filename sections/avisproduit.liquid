{% comment %}
  Section : Avis produit custom
  Fonts : Manrope + DM Sans
{% endcomment %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">

<section
  class="product-reviews section-{{ section.id }}"
  style="
    --section-bg: {{ section.settings.background_color }};
    --text-color: {{ section.settings.text_color }};
    --muted-color: {{ section.settings.muted_text_color }};
    --accent-color: {{ section.settings.accent_color }};
    --line-color: {{ section.settings.line_color }};
    --verified-color: {{ section.settings.verified_color }};
    --pagination-bg: {{ section.settings.pagination_background }};
    --pagination-text: {{ section.settings.pagination_text_color }};

    --max-width: {{ section.settings.max_width }}px;

    --padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;

    --title-size-desktop: {{ section.settings.title_size_desktop }}px;
    --title-size-mobile: {{ section.settings.title_size_mobile }}px;
    --rating-size-desktop: {{ section.settings.rating_size_desktop }}px;
    --rating-size-mobile: {{ section.settings.rating_size_mobile }}px;
    --stars-size: {{ section.settings.stars_size }}px;
    --summary-size: {{ section.settings.summary_size }}px;
    --verified-reviews-logo-width: {{ section.settings.verified_reviews_logo_width }}px;
    --name-size: {{ section.settings.name_size }}px;
    --verified-size: {{ section.settings.verified_size }}px;
    --review-title-size: {{ section.settings.review_title_size }}px;
    --review-text-size: {{ section.settings.review_text_size }}px;
    --date-size: {{ section.settings.date_size }}px;

    --title-bottom-space: {{ section.settings.title_bottom_space }}px;
    --summary-bottom-space: {{ section.settings.summary_bottom_space }}px;
    --review-padding-y: {{ section.settings.review_padding_y }}px;

    --footer-bg: {{ section.settings.footer_background_color }};
    --footer-text: {{ section.settings.footer_text_color }};
    --footer-muted: {{ section.settings.footer_muted_color }};
    --footer-icon-bg: {{ section.settings.footer_icon_background }};
    --footer-icon-color: {{ section.settings.footer_icon_color }};
  "
>
  <div class="product-reviews__inner">

    {% assign show_verified_source = false %}
    {% if section.settings.show_verified_reviews %}
      {% if section.settings.verified_reviews_logo != blank %}
        {% assign show_verified_source = true %}
      {% elsif section.settings.verified_reviews_link_text != blank and section.settings.verified_reviews_url != blank %}
        {% assign show_verified_source = true %}
      {% endif %}
    {% endif %}

    {% if section.settings.title != blank %}
      <div class="product-reviews__title-wrapper">
        <h2 class="product-reviews__title">
          {{ section.settings.title }}
        </h2>
      </div>
    {% endif %}

    {% if show_verified_source %}
        <div class="product-reviews__verified-source">
          {% if section.settings.verified_reviews_logo != blank %}
            {% if section.settings.verified_reviews_url != blank %}
              <a
                class="product-reviews__verified-logo-link"
                href="{{ section.settings.verified_reviews_url }}"
                {% if section.settings.verified_reviews_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
                aria-label="Consulter tous les avis clients"
              >
            {% endif %}

            <img
              class="product-reviews__verified-logo"
              src="{{ section.settings.verified_reviews_logo | image_url: width: 500 }}"
              alt="{{ section.settings.verified_reviews_logo_alt | escape }}"
              width="{{ section.settings.verified_reviews_logo_width }}"
              loading="lazy"
            >

            {% if section.settings.verified_reviews_url != blank %}
              </a>
            {% endif %}
          {% endif %}

          {% if section.settings.verified_reviews_link_text != blank and section.settings.verified_reviews_url != blank %}
            <a
              class="product-reviews__verified-link"
              href="{{ section.settings.verified_reviews_url }}"
              {% if section.settings.verified_reviews_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{ section.settings.verified_reviews_link_text }}
            </a>
          {% endif %}
        </div>
    {% endif %}

    <div class="product-reviews__summary{% unless show_verified_source %} product-reviews__summary--without-verified-source{% endunless %}">
      <div class="product-reviews__rating-line">
        {% if section.settings.rating != blank %}
          <span class="product-reviews__rating">
            {{ section.settings.rating }}
          </span>
        {% endif %}

        {% if section.settings.stars != blank %}
          <span class="product-reviews__stars">
            {{ section.settings.stars }}
          </span>
        {% endif %}
      </div>

      {% if section.settings.based_text != blank %}
        <div class="product-reviews__based">
          {{ section.settings.based_text }}
        </div>
      {% endif %}
    </div>

    <div class="product-reviews__list">
      {% for block in section.blocks %}
        {% if block.type == 'review' %}
          <article class="product-reviews__item" {{ block.shopify_attributes }}>

            <div class="product-reviews__author">
              {% if block.settings.name != blank %}
                <div class="product-reviews__name">
                  {{ block.settings.name }}
                </div>
              {% endif %}

              {% if block.settings.verified != blank %}
                <div class="product-reviews__verified">
                  <span class="product-reviews__verified-icon">✓</span>
                  {{ block.settings.verified }}
                </div>
              {% endif %}
            </div>

            <div class="product-reviews__content">
              <div class="product-reviews__review-head">
                <div class="product-reviews__review-left">
                  {% if block.settings.stars != blank %}
                    <span class="product-reviews__review-stars">
                      {{ block.settings.stars }}
                    </span>
                  {% endif %}

                  {% if block.settings.review_title != blank %}
                    <h3 class="product-reviews__review-title">
                      {{ block.settings.review_title }}
                    </h3>
                  {% endif %}
                </div>

                {% if block.settings.date != blank %}
                  <div class="product-reviews__date">
                    {{ block.settings.date }}
                  </div>
                {% endif %}
              </div>

              {% if block.settings.text != blank %}
                <div class="product-reviews__text">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>

          </article>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.show_pagination %}
      <div class="product-reviews__pagination">
        <button class="product-reviews__page-arrow" type="button" aria-label="Page précédente">
          ‹
        </button>

        {% assign pages = section.settings.pagination_pages | split: ',' %}
        {% for page in pages %}
          {% assign clean_page = page | strip %}
          <button
            class="product-reviews__page {% if forloop.first %}is-active{% endif %}"
            type="button"
          >
            {{ clean_page }}
          </button>
        {% endfor %}

        <button class="product-reviews__page-arrow" type="button" aria-label="Page suivante">
          ›
        </button>
      </div>
    {% endif %}

  </div>

  {% if section.settings.show_footer %}
    <div class="product-reviews__footer">
      <div class="product-reviews__footer-inner">

        <div class="product-reviews__footer-brand">
          {% if section.settings.footer_logo != blank %}
            <img
              class="product-reviews__footer-logo-img"
              src="{{ section.settings.footer_logo | image_url: width: 80 }}"
              alt="{{ section.settings.footer_brand_name | escape }}"
              width="32"
              height="32"
              loading="lazy"
            >
          {% else %}
            <span class="product-reviews__footer-logo-fallback" aria-hidden="true">
              {{ section.settings.footer_brand_name | slice: 0, 1 }}
            </span>
          {% endif %}

          {% if section.settings.footer_brand_name != blank %}
            <span class="product-reviews__footer-brand-name">
              {{ section.settings.footer_brand_name }}
            </span>
          {% endif %}
        </div>

        <div class="product-reviews__footer-social">
          {% if section.settings.footer_facebook_url != blank %}
            <a class="product-reviews__footer-icon" href="{{ section.settings.footer_facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.66V3.6C15.87 3.5 14.9 3.4 13.8 3.4c-2.3 0-3.9 1.4-3.9 4v2.5H7.2V13h2.7v8h3.6z"/></svg>
            </a>
          {% endif %}

          {% if section.settings.footer_instagram_url != blank %}
            <a class="product-reviews__footer-icon" href="{{ section.settings.footer_instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12 8.4a3.6 3.6 0 1 0 0 7.2 3.6 3.6 0 0 0 0-7.2zm0 5.94a2.34 2.34 0 1 1 0-4.68 2.34 2.34 0 0 1 0 4.68zM16.9 8.26a.84.84 0 1 1-1.68 0 .84.84 0 0 1 1.68 0zM21 7.6c-.06-1.2-.33-2.26-1.2-3.13C18.93 3.6 17.87 3.33 16.67 3.27 15.44 3.2 8.56 3.2 7.33 3.27 6.13 3.33 5.07 3.6 4.2 4.47 3.33 5.34 3.06 6.4 3 7.6 2.93 8.83 2.93 15.17 3 16.4c.06 1.2.33 2.26 1.2 3.13.87.87 1.93 1.14 3.13 1.2 1.23.07 8.11.07 9.34 0 1.2-.06 2.26-.33 3.13-1.2.87-.87 1.14-1.93 1.2-3.13.07-1.23.07-7.57 0-8.8zm-2.43 10.7c-.26.65-.76 1.15-1.41 1.41-.98.39-3.3.3-4.16.3s-3.19.08-4.16-.3a2.53 2.53 0 0 1-1.41-1.41c-.39-.98-.3-3.3-.3-4.16s-.08-3.19.3-4.16c.26-.65.76-1.15 1.41-1.41.97-.39 3.3-.3 4.16-.3s3.19-.08 4.16.3c.65.26 1.15.76 1.41 1.41.39.98.3 3.3.3 4.16s.09 3.19-.3 4.16z"/></svg>
            </a>
          {% endif %}

          {% if section.settings.footer_tiktok_url != blank %}
            <a class="product-reviews__footer-icon" href="{{ section.settings.footer_tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M16.6 5.82c-.9-.98-1.4-2.26-1.4-3.62h-3.03v13.4c0 1.5-1.22 2.72-2.72 2.72a2.72 2.72 0 0 1 0-5.44c.28 0 .55.04.8.12V9.9a5.75 5.75 0 0 0-.8-.06 5.75 5.75 0 1 0 5.75 5.75V9.2a7.3 7.3 0 0 0 4.27 1.36V7.53c-1.03 0-2.03-.36-2.87-.99z"/></svg>
            </a>
          {% endif %}

          {% if section.settings.footer_linkedin_url != blank %}
            <a class="product-reviews__footer-icon" href="{{ section.settings.footer_linkedin_url }}" target="_blank" rel="noopener" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M6.94 8.5H4.06V20h2.88V8.5zM5.5 4a1.67 1.67 0 1 0 0 3.34A1.67 1.67 0 0 0 5.5 4zM20 13.36c0-3.1-1.66-4.55-3.87-4.55-1.78 0-2.58.98-3.02 1.66V8.5H10.2c.04.83 0 11.5 0 11.5h2.9v-6.42c0-.34.02-.68.12-.93.28-.68.9-1.4 1.96-1.4 1.38 0 1.94 1.06 1.94 2.6V20H20v-6.64z"/></svg>
            </a>
          {% endif %}
        </div>

        {% if section.settings.footer_cookie_text != blank %}
          <a
            class="product-reviews__footer-cookie"
            href="{{ section.settings.footer_cookie_url | default: '#' }}"
            {% if section.settings.footer_cookie_opens_preferences %}data-cookie-preferences="true"{% endif %}
          >
            {{ section.settings.footer_cookie_text }}
          </a>
        {% endif %}

      </div>
    </div>
  {% endif %}

</section>

<style>
  .section-{{ section.id }} {
    width: 100%;
    background: var(--section-bg);
    color: var(--text-color);
    overflow: hidden;
  }

  .section-{{ section.id }} .product-reviews__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: var(--padding-top-desktop) 48px var(--padding-bottom-desktop);
  }

  .section-{{ section.id }} .product-reviews__title-wrapper {
    text-align: center;
  }

  .section-{{ section.id }} .product-reviews__title {
    font-family: "Manrope", sans-serif;
    font-size: var(--title-size-desktop);
    line-height: 1.2;
    font-weight: 600;
    color: var(--text-color);
    text-align: center;
    margin: 0;
  }

  .section-{{ section.id }} .product-reviews__verified-source {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin: clamp(20px, calc(var(--title-bottom-space) * 0.45), 40px) 0 24px;
    text-align: center;
  }

  .section-{{ section.id }} .product-reviews__verified-logo-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
  }

  .section-{{ section.id }} .product-reviews__verified-logo {
    display: block;
    width: min(var(--verified-reviews-logo-width), 100%);
    height: auto;
    object-fit: contain;
  }

  .section-{{ section.id }} .product-reviews__verified-link {
    font-family: "DM Sans", sans-serif;
    font-size: 14px;
    line-height: 1.3;
    font-weight: 500;
    color: var(--text-color);
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .section-{{ section.id }} .product-reviews__verified-link:hover {
    opacity: 0.75;
  }

  .section-{{ section.id }} .product-reviews__summary {
    text-align: center;
    margin-bottom: var(--summary-bottom-space);
  }

  .section-{{ section.id }} .product-reviews__summary--without-verified-source {
    margin-top: var(--title-bottom-space);
  }

  .section-{{ section.id }} .product-reviews__rating-line {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  .section-{{ section.id }} .product-reviews__rating {
    font-family: "DM Sans", sans-serif;
    font-size: var(--rating-size-desktop);
    line-height: 1;
    font-weight: 500;
    color: var(--text-color);
  }

  .section-{{ section.id }} .product-reviews__stars,
  .section-{{ section.id }} .product-reviews__review-stars {
    font-family: "DM Sans", sans-serif;
    font-size: var(--stars-size);
    line-height: 1;
    color: var(--accent-color);
    letter-spacing: 1px;
    white-space: nowrap;
  }

  .section-{{ section.id }} .product-reviews__based {
    font-family: "DM Sans", sans-serif;
    font-size: var(--summary-size);
    line-height: 1.2;
    font-weight: 400;
    color: var(--muted-color);
    margin-top: 4px;
  }

  .section-{{ section.id }} .product-reviews__list {
    width: 100%;
  }

  .section-{{ section.id }} .product-reviews__item {
    display: grid;
    grid-template-columns: 190px 1fr;
    gap: 28px;
    padding: var(--review-padding-y) 0;
    border-bottom: 1px solid var(--line-color);
  }

  .section-{{ section.id }} .product-reviews__author {
    padding-top: 4px;
  }

  .section-{{ section.id }} .product-reviews__name {
    font-family: "DM Sans", sans-serif;
    font-size: var(--name-size);
    line-height: 1.2;
    font-weight: 500;
    color: var(--text-color);
  }

  .section-{{ section.id }} .product-reviews__verified {
    font-family: "DM Sans", sans-serif;
    font-size: var(--verified-size);
    line-height: 1.2;
    font-weight: 400;
    color: var(--text-color);
    margin-top: 4px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
  }

  .section-{{ section.id }} .product-reviews__verified-icon {
    width: 13px;
    height: 13px;
    border-radius: 999px;
    background: var(--verified-color);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 9px;
    line-height: 1;
    font-weight: 700;
  }

  .section-{{ section.id }} .product-reviews__review-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .section-{{ section.id }} .product-reviews__review-left {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .section-{{ section.id }} .product-reviews__review-title {
    font-family: "DM Sans", sans-serif;
    font-size: var(--review-title-size);
    line-height: 1.25;
    font-weight: 700;
    color: var(--text-color);
    margin: 0;
  }

  .section-{{ section.id }} .product-reviews__date {
    font-family: "DM Sans", sans-serif;
    font-size: var(--date-size);
    line-height: 1.2;
    font-weight: 400;
    color: var(--text-color);
    white-space: nowrap;
  }

  .section-{{ section.id }} .product-reviews__text {
    font-family: "DM Sans", sans-serif;
    font-size: var(--review-text-size);
    line-height: 1.55;
    font-weight: 400;
    color: var(--text-color);
    margin-top: 18px;
  }

  .section-{{ section.id }} .product-reviews__text p {
    margin: 0;
  }

  .section-{{ section.id }} .product-reviews__pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 22px;
    margin-top: 54px;
  }

  .section-{{ section.id }} .product-reviews__page,
  .section-{{ section.id }} .product-reviews__page-arrow {
    appearance: none;
    border: none;
    background: transparent;
    font-family: "DM Sans", sans-serif;
    font-size: 15px;
    line-height: 1;
    color: var(--text-color);
    cursor: pointer;
    padding: 0;
  }

  .section-{{ section.id }} .product-reviews__page {
    width: 28px;
    height: 28px;
    border-radius: 4px;
  }

  .section-{{ section.id }} .product-reviews__page.is-active {
    background: var(--pagination-bg);
    color: var(--pagination-text);
  }

  .section-{{ section.id }} .product-reviews__page-arrow {
    font-size: 28px;
    color: var(--muted-color);
  }

  /* ---------- Footer générique ---------- */

  .section-{{ section.id }} .product-reviews__footer {
    width: 100%;
    background: var(--footer-bg);
  }

  .section-{{ section.id }} .product-reviews__footer-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 28px 48px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    flex-wrap: wrap;
  }

  .section-{{ section.id }} .product-reviews__footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-{{ section.id }} .product-reviews__footer-logo-img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    border-radius: 6px;
  }

  .section-{{ section.id }} .product-reviews__footer-logo-fallback {
    width: 32px;
    height: 32px;
    border-radius: 999px;
    background: var(--footer-icon-bg);
    color: var(--footer-icon-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: "Manrope", sans-serif;
    font-weight: 700;
    font-size: 15px;
    text-transform: uppercase;
  }

  .section-{{ section.id }} .product-reviews__footer-brand-name {
    font-family: "Manrope", sans-serif;
    font-weight: 700;
    font-size: 17px;
    line-height: 1.2;
    color: var(--footer-text);
  }

  .section-{{ section.id }} .product-reviews__footer-social {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .section-{{ section.id }} .product-reviews__footer-icon {
    width: 34px;
    height: 34px;
    border-radius: 999px;
    background: var(--footer-icon-bg);
    color: var(--footer-icon-color);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .section-{{ section.id }} .product-reviews__footer-icon:hover {
    opacity: 0.8;
  }

  .section-{{ section.id }} .product-reviews__footer-cookie {
    font-family: "DM Sans", sans-serif;
    font-size: 13px;
    line-height: 1.2;
    color: var(--footer-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media screen and (max-width: 989px) {
    .section-{{ section.id }} .product-reviews__inner {
      padding: var(--padding-top-mobile) 24px var(--padding-bottom-mobile);
    }

    .section-{{ section.id }} .product-reviews__title {
      font-size: var(--title-size-mobile);
    }

    .section-{{ section.id }} .product-reviews__verified-source {
      gap: 12px;
      margin-top: 24px;
      margin-bottom: 20px;
    }

    .section-{{ section.id }} .product-reviews__verified-link {
      font-size: 13px;
    }

    .section-{{ section.id }} .product-reviews__rating {
      font-size: var(--rating-size-mobile);
    }

    .section-{{ section.id }} .product-reviews__summary {
      margin-bottom: 48px;
    }

    .section-{{ section.id }} .product-reviews__item {
      grid-template-columns: 1fr;
      gap: 18px;
      padding: calc(var(--review-padding-y) * 0.72) 0;
    }

    .section-{{ section.id }} .product-reviews__author {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding-top: 0;
    }

    .section-{{ section.id }} .product-reviews__review-head {
      gap: 14px;
    }

    .section-{{ section.id }} .product-reviews__review-left {
      align-items: flex-start;
      flex-direction: column;
      gap: 8px;
    }

    .section-{{ section.id }} .product-reviews__text {
      margin-top: 14px;
    }

    .section-{{ section.id }} .product-reviews__pagination {
      gap: 16px;
      margin-top: 38px;
    }

    .section-{{ section.id }} .product-reviews__footer-inner {
      padding: 24px;
      justify-content: center;
      text-align: center;
    }
  }

  @media screen and (max-width: 749px) {
    .section-{{ section.id }} .product-reviews__inner {
