      "id": "padding_top_desktop",
      "label": "Marge haute desktop",
      "min": 30,
      "max": 140,
      "step": 2,
      "unit": "px",
      "default": 42
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Marge basse desktop",
