      "min": 22,
      "max": 42,
      "step": 1,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "rating_size_desktop",
      "label": "Taille note desktop",
      "min": 26,
      "max": 58,
      "step": 1,
      "unit": "px",
      "default": 46
    },
    {
      "type": "range",
      "id": "rating_size_mobile",
      "label": "Taille note mobile",
      "min": 24,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "stars_size",
      "label": "Taille étoiles",
      "min": 14,
      "max": 32,
