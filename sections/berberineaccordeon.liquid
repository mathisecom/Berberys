{% comment %}
  Section Shopify : Berbérine - Plus produit + Accordéon
  Police titres : Manrope
  Police paragraphes : DM Sans
{% endcomment %}

<section
  id="berberine-plus-{{ section.id }}"
  class="berberine-plus-section"
  style="
    --bg-color: {{ section.settings.bg_color }};
    --text-color: {{ section.settings.text_color }};
    --heading-color: {{ section.settings.heading_color }};
    --card-bg: {{ section.settings.card_bg }};
    --line-color: {{ section.settings.line_color }};
    --radius: {{ section.settings.radius }}px;
    --max-width: {{ section.settings.max_width }}px;
    --top-padding-desktop: {{ section.settings.padding_top_desktop }}px;
    --bottom-padding-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --side-padding-desktop: {{ section.settings.padding_side_desktop }}px;
    --top-padding-mobile: {{ section.settings.padding_top_mobile }}px;
    --bottom-padding-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --side-padding-mobile: {{ section.settings.padding_side_mobile }}px;
  "
>
  <div class="berberine-plus-inner">

    <div class="berberine-plus-header">
      {% if section.settings.title != blank %}
        <h2>{{ section.settings.title }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p>{{ section.settings.subtitle }}</p>
      {% endif %}
    </div>

    <div class="berberine-plus-main">
      <div class="berberine-plus-column berberine-plus-left">
        {% for block in section.blocks %}
          {% if block.type == 'feature' and block.settings.position == 'left' %}
            <div class="berberine-plus-feature" {{ block.shopify_attributes }}>
              <div class="feature-line"></div>

              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="feature-text">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="berberine-plus-image-wrap">
        {% if section.settings.center_image != blank %}
          {{
            section.settings.center_image
            | image_url: width: 900
            | image_tag:
              loading: 'lazy',
              class: 'berberine-plus-center-image',
              alt: section.settings.title
          }}
        {% else %}
          <div class="berberine-plus-placeholder">
            {{ 'product-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="berberine-plus-column berberine-plus-right">
        {% for block in section.blocks %}
          {% if block.type == 'feature' and block.settings.position == 'right' %}
            <div class="berberine-plus-feature" {{ block.shopify_attributes }}>
              <div class="feature-line"></div>

              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}

              {% if block.settings.text != blank %}
                <div class="feature-text">
                  {{ block.settings.text }}
                </div>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="berberine-plus-accordion">
      {% for block in section.blocks %}
        {% if block.type == 'accordion' %}
          <div
            class="berberine-accordion-item {% if block.settings.open_by_default %}is-open{% endif %}"
            {{ block.shopify_attributes }}
          >
            <button class="berberine-accordion-button" type="button" aria-expanded="{% if block.settings.open_by_default %}true{% else %}false{% endif %}">
              <span class="accordion-title-wrap">
                {% if block.settings.icon != blank %}
                  {{
                    block.settings.icon
                    | image_url: width: 120
                    | image_tag:
                      loading: 'lazy',
                      class: 'accordion-icon',
                      alt: block.settings.title
                  }}
                {% endif %}

                {% if block.settings.title != blank %}
                  <span class="accordion-title">{{ block.settings.title }}</span>
                {% endif %}
              </span>

              <span class="accordion-symbol">
                <span class="plus">+</span>
                <span class="minus">−</span>
              </span>
            </button>

            <div class="berberine-accordion-content">
              <div class="accordion-content-inner">
                <div class="accordion-text">
                  {{ block.settings.content }}
                </div>

                {% if block.settings.content_image != blank %}
                  <div class="accordion-image-wrap">
                    {{
                      block.settings.content_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        class: 'accordion-image',
                        alt: block.settings.title
                    }}
                  </div>
                {% endif %}
              </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700;9..40,800&family=Manrope:wght@400;500;600;700;800&display=swap');

  #berberine-plus-{{ section.id }} {
    background: var(--bg-color);
    color: var(--text-color);
    padding: var(--top-padding-desktop) var(--side-padding-desktop) var(--bottom-padding-desktop);
    overflow: hidden;
    font-family: 'DM Sans', sans-serif;
  }

  #berberine-plus-{{ section.id }} * {
    box-sizing: border-box;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_margin_bottom }}px;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-header h2 {
    margin: 0;
    color: var(--heading-color);
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.title_size_desktop }}px;
    line-height: 1.12;
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: -0.045em;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-header p {
    margin: 10px 0 0;
    color: var(--text-color);
    font-family: 'DM Sans', sans-serif;
    font-size: {{ section.settings.subtitle_size_desktop }}px;
    font-style: italic;
    line-height: 1.3;
    font-weight: 500;
    opacity: 0.9;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-main {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: {{ section.settings.main_gap }}px;
    margin-bottom: {{ section.settings.main_margin_bottom }}px;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-column {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.feature_gap }}px;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-feature {
    position: relative;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-feature h3 {
    margin: 0 0 16px;
    color: var(--heading-color);
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.feature_title_size }}px;
    line-height: 0.95;
    font-weight: {{ section.settings.feature_title_weight }};
    text-transform: uppercase;
    letter-spacing: -0.055em;
  }

  #berberine-plus-{{ section.id }} .feature-line {
    width: 100%;
    height: 1px;
    background: var(--line-color);
    margin-bottom: 18px;
    position: relative;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-left .feature-line::after {
    content: "";
    position: absolute;
    right: -90px;
    top: 0;
    width: 95px;
    height: 1px;
    background: var(--line-color);
    transform: rotate(20deg);
    transform-origin: left center;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-right .feature-line::before {
    content: "";
    position: absolute;
    left: -90px;
    top: 0;
    width: 95px;
    height: 1px;
    background: var(--line-color);
    transform: rotate(-20deg);
    transform-origin: right center;
  }

  #berberine-plus-{{ section.id }} .feature-text {
    color: var(--text-color);
    font-family: 'DM Sans', sans-serif;
    font-size: {{ section.settings.feature_text_size }}px;
    line-height: 1.35;
    font-weight: 500;
  }

  #berberine-plus-{{ section.id }} .feature-text ul {
    margin: 0;
    padding-left: 18px;
  }

  #berberine-plus-{{ section.id }} .feature-text li {
    margin-bottom: 4px;
  }

  #berberine-plus-{{ section.id }} .feature-text p {
    margin: 0 0 10px;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-image-wrap {
    width: {{ section.settings.center_image_size }}px;
    height: {{ section.settings.center_image_size }}px;
    border-radius: 50%;
    overflow: hidden;
    border: {{ section.settings.center_border_width }}px solid {{ section.settings.center_border_color }};
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.18);
    background: #fff;
    flex-shrink: 0;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-center-image,
  #berberine-plus-{{ section.id }} .berberine-plus-placeholder svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #berberine-plus-{{ section.id }} .berberine-plus-accordion {
    max-width: {{ section.settings.accordion_max_width }}px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.accordion_gap }}px;
  }

  #berberine-plus-{{ section.id }} .berberine-accordion-item {
    background: var(--card-bg);
    border-radius: var(--radius);
    overflow: hidden;
  }

  #berberine-plus-{{ section.id }} .berberine-accordion-button {
    width: 100%;
    border: 0;
    background: transparent;
    color: var(--heading-color);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: {{ section.settings.accordion_padding_y }}px {{ section.settings.accordion_padding_x }}px;
    text-align: left;
    font-family: 'Manrope', sans-serif;
  }

  #berberine-plus-{{ section.id }} .accordion-title-wrap {
    display: flex;
    align-items: center;
    gap: 18px;
    min-width: 0;
  }

  #berberine-plus-{{ section.id }} .accordion-icon {
    width: {{ section.settings.accordion_icon_width }}px;
    height: {{ section.settings.accordion_icon_height }}px;
    border-radius: {{ section.settings.accordion_icon_radius }}px;
    object-fit: cover;
    flex-shrink: 0;
  }

  #berberine-plus-{{ section.id }} .accordion-title {
    color: var(--heading-color);
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.accordion_title_size }}px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  #berberine-plus-{{ section.id }} .accordion-symbol {
    color: var(--heading-color);
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.symbol_size }}px;
    line-height: 1;
    font-weight: 600;
    flex-shrink: 0;
  }

  #berberine-plus-{{ section.id }} .accordion-symbol .minus {
    display: none;
  }

  #berberine-plus-{{ section.id }} .berberine-accordion-item.is-open .accordion-symbol .plus {
    display: none;
  }

  #berberine-plus-{{ section.id }} .berberine-accordion-item.is-open .accordion-symbol .minus {
    display: inline;
  }

  #berberine-plus-{{ section.id }} .berberine-accordion-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.35s ease;
  }

  #berberine-plus-{{ section.id }} .berberine-accordion-item.is-open .berberine-accordion-content {
    max-height: 1200px;
  }

  #berberine-plus-{{ section.id }} .accordion-content-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) {{ section.settings.content_image_width }}%;
    gap: {{ section.settings.content_gap }}px;
    padding: 0 {{ section.settings.accordion_padding_x }}px {{ section.settings.content_padding_bottom }}px;
    align-items: start;
  }

  #berberine-plus-{{ section.id }} .accordion-text {
    color: var(--text-color);
    font-family: 'DM Sans', sans-serif;
    font-size: {{ section.settings.content_text_size }}px;
    line-height: 1.45;
    font-weight: 500;
  }

  #berberine-plus-{{ section.id }} .accordion-text p {
    margin-top: 0;
    margin-bottom: 18px;
  }

  #berberine-plus-{{ section.id }} .accordion-text strong {
    color: var(--heading-color);
    font-weight: 800;
  }

  #berberine-plus-{{ section.id }} .accordion-text ul,
  #berberine-plus-{{ section.id }} .accordion-text ol {
    margin-top: 0;
    padding-left: 20px;
  }

  #berberine-plus-{{ section.id }} .accordion-image-wrap {
    width: 100%;
    height: {{ section.settings.content_image_height }}px;
    border-radius: {{ section.settings.content_image_radius }}px;
    overflow: hidden;
  }

  #berberine-plus-{{ section.id }} .accordion-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media screen and (max-width: 989px) {
    #berberine-plus-{{ section.id }} .berberine-plus-main {
      grid-template-columns: 1fr;
      gap: 34px;
      text-align: left;
    }

    #berberine-plus-{{ section.id }} .berberine-plus-image-wrap {
      order: -1;
      margin: 0 auto;
    }

    #berberine-plus-{{ section.id }} .berberine-plus-left .feature-line::after,
    #berberine-plus-{{ section.id }} .berberine-plus-right .feature-line::before {
      display: none;
    }

    #berberine-plus-{{ section.id }} .accordion-content-inner {
      grid-template-columns: 1fr;
    }

    #berberine-plus-{{ section.id }} .accordion-image-wrap {
      height: {{ section.settings.content_image_height_mobile }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #berberine-plus-{{ section.id }} {
      padding: var(--top-padding-mobile) var(--side-padding-mobile) var(--bottom-padding-mobile);
    }

    #berberine-plus-{{ section.id }} .berberine-plus-header {
      margin-bottom: {{ section.settings.header_margin_bottom_mobile }}px;
    }

    #berberine-plus-{{ section.id }} .berberine-plus-header h2 {
      font-size: {{ section.settings.title_size_mobile }}px;
      line-height: 1.12;
    }

    #berberine-plus-{{ section.id }} .berberine-plus-header p {
      font-size: {{ section.settings.subtitle_size_mobile }}px;
    }

    #berberine-plus-{{ section.id }} .berberine-plus-main {
      margin-bottom: {{ section.settings.main_margin_bottom_mobile }}px;
    }

    #berberine-plus-{{ section.id }} .berberine-plus-image-wrap {
      width: {{ section.settings.center_image_size_mobile }}px;
      height: {{ section.settings.center_image_size_mobile }}px;
    }

    #berberine-plus-{{ section.id }} .berberine-plus-column {
      gap: {{ section.settings.feature_gap_mobile }}px;
    }

    #berberine-plus-{{ section.id }} .berberine-plus-feature h3 {
      font-size: {{ section.settings.feature_title_size_mobile }}px;
      margin-bottom: 12px;
    }

    #berberine-plus-{{ section.id }} .feature-text {
      font-size: {{ section.settings.feature_text_size_mobile }}px;
    }

    #berberine-plus-{{ section.id }} .berberine-accordion-button {
      padding: {{ section.settings.accordion_padding_y_mobile }}px {{ section.settings.accordion_padding_x_mobile }}px;
    }

    #berberine-plus-{{ section.id }} .accordion-title-wrap {
      gap: 12px;
    }

    #berberine-plus-{{ section.id }} .accordion-icon {
      width: {{ section.settings.accordion_icon_width_mobile }}px;
      height: {{ section.settings.accordion_icon_height_mobile }}px;
    }

    #berberine-plus-{{ section.id }} .accordion-title {
      font-size: {{ section.settings.accordion_title_size_mobile }}px;
    }

    #berberine-plus-{{ section.id }} .accordion-content-inner {
      padding: 0 {{ section.settings.accordion_padding_x_mobile }}px {{ section.settings.content_padding_bottom_mobile }}px;
      gap: 22px;
    }

    #berberine-plus-{{ section.id }} .accordion-text {
      font-size: {{ section.settings.content_text_size_mobile }}px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#berberine-plus-{{ section.id }}');
    if (!section) return;

    const items = section.querySelectorAll('.berberine-accordion-item');

    items.forEach(function (item) {
      const button = item.querySelector('.berberine-accordion-button');

      if (!button) return;

      button.addEventListener('click', function () {
        const isOpen = item.classList.contains('is-open');

        {% if section.settings.close_others %}
          items.forEach(function (otherItem) {
            otherItem.classList.remove('is-open');
            const otherButton = otherItem.querySelector('.berberine-accordion-button');
            if (otherButton) otherButton.setAttribute('aria-expanded', 'false');
          });
        {% endif %}

        if (!isOpen) {
          item.classList.add('is-open');
          button.setAttribute('aria-expanded', 'true');
        } else {
          item.classList.remove('is-open');
          button.setAttribute('aria-expanded', 'false');
        }
      });
    });
  });
</script>

{% schema %}
{
  "name": "Plus produit accordéon",
  "settings": [
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur de fond",
      "default": "#f3f4fb"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Fond des accordéons",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Couleur des titres",
      "default": "#111b4d"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur du texte",
      "default": "#111b4d"
    },
    {
      "type": "color",
      "id": "line_color",
      "label": "Couleur des traits",
      "default": "#b9bfd5"
    },
    {
      "type": "header",
      "content": "Titre principal"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titre",
      "default": "Les plus de notre Berbérine pure"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sous-titre",
      "default": "Extrait Berberis aristata"
    },
    {
      "type": "range",
      "id": "title_size_desktop",
      "label": "Taille titre PC",
      "min": 22,
      "max": 70,
      "step": 1,
      "default": 42
    },
    {
      "type": "range",
      "id": "title_size_mobile",
      "label": "Taille titre mobile",
      "min": 20,
      "max": 46,
      "step": 1,
      "default": 30
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Épaisseur du titre",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra-bold"
        }
      ]
    },
    {
      "type": "range",
      "id": "subtitle_size_desktop",
      "label": "Taille sous-titre PC",
      "min": 10,
      "max": 24,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "subtitle_size_mobile",
      "label": "Taille sous-titre mobile",
      "min": 10,
      "max": 22,
      "step": 1,
      "default": 13
    },
    {
      "type": "range",
      "id": "header_margin_bottom",
      "label": "Marge sous le titre PC",
      "min": 10,
      "max": 90,
      "step": 2,
      "default": 56
    },
    {
      "type": "range",
      "id": "header_margin_bottom_mobile",
      "label": "Marge sous le titre mobile",
      "min": 10,
      "max": 70,
      "step": 2,
      "default": 34
    },
    {
      "type": "header",
      "content": "Image centrale"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Image ronde centrale"
    },
    {
      "type": "range",
      "id": "center_image_size",
      "label": "Taille image PC",
      "min": 180,
      "max": 480,
      "step": 10,
      "default": 340
    },
    {
      "type": "range",
      "id": "center_image_size_mobile",
      "label": "Taille image mobile",
      "min": 140,
      "max": 340,
      "step": 10,
      "default": 240
    },
    {
      "type": "range",
      "id": "center_border_width",
      "label": "Épaisseur bordure image",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "color",
      "id": "center_border_color",
      "label": "Couleur bordure image",
      "default": "#bfc1c9"
    },
    {
      "type": "header",
      "content": "Blocs autour de l'image"
    },
    {
      "type": "range",
      "id": "main_gap",
      "label": "Espace entre colonnes PC",
      "min": 20,
      "max": 120,
      "step": 2,
      "default": 70
    },
    {
      "type": "range",
      "id": "feature_gap",
      "label": "Espace entre arguments PC",
      "min": 20,
      "max": 90,
      "step": 2,
      "default": 48
    },
    {
      "type": "range",
      "id": "feature_gap_mobile",
      "label": "Espace entre arguments mobile",
      "min": 16,
      "max": 70,
      "step": 2,
      "default": 30
    },
    {
      "type": "range",
      "id": "feature_title_size",
      "label": "Taille titre argument PC",
      "min": 14,
      "max": 34,
      "step": 1,
      "default": 25
    },
    {
      "type": "range",
      "id": "feature_title_size_mobile",
      "label": "Taille titre argument mobile",
      "min": 14,
      "max": 30,
      "step": 1,
      "default": 21
    },
    {
      "type": "select",
      "id": "feature_title_weight",
      "label": "Épaisseur titre argument",
      "default": "600",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "500",
          "label": "Medium"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
