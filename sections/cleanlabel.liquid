{% comment %}
  Section Shopify : Clean Label Slider
  Police titres : Manrope
  Police paragraphes : DM Sans
{% endcomment %}

<section
  id="clean-label-{{ section.id }}"
  class="clean-label-section"
  style="
    --bg-color: {{ section.settings.bg_color }};
    --title-color: {{ section.settings.title_color }};
    --text-color: {{ section.settings.text_color }};
    --card-bg: {{ section.settings.card_bg }};
    --card-border: {{ section.settings.card_border }};
    --line-color: {{ section.settings.line_color }};
    --dot-color: {{ section.settings.dot_color }};
    --dot-active-color: {{ section.settings.dot_active_color }};

    --max-width: {{ section.settings.max_width }}px;

    --padding-top-desktop: {{ section.settings.padding_top_desktop }}px;
    --padding-bottom-desktop: {{ section.settings.padding_bottom_desktop }}px;
    --padding-left-desktop: {{ section.settings.padding_left_desktop }}px;
    --padding-right-desktop: {{ section.settings.padding_right_desktop }}px;

    --padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --padding-left-mobile: {{ section.settings.padding_left_mobile }}px;
    --padding-right-mobile: {{ section.settings.padding_right_mobile }}px;

    --image-size-desktop: {{ section.settings.image_size_desktop }}px;
    --image-size-mobile: {{ section.settings.image_size_mobile }}px;
  "
>
  <div class="clean-label-inner">

    <div class="clean-label-title-wrap">
      {% if section.settings.title != blank %}
        <h2 class="clean-label-main-title">{{ section.settings.title }}</h2>
      {% endif %}
    </div>

    <div class="clean-label-desktop">
      <div class="clean-label-images">
        {% for block in section.blocks %}
          <div class="clean-label-image-item" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 700
                | image_tag:
                  loading: 'lazy',
                  class: 'clean-label-image',
                  alt: block.settings.title
              }}
            {% else %}
              <div class="clean-label-placeholder">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>
        {% endfor %}
      </div>

      <div class="clean-label-cards">
        {% for block in section.blocks %}
          <article class="clean-label-card" {{ block.shopify_attributes }}>
            <span class="clean-label-line"></span>

            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>

    <div class="clean-label-mobile">
      <div class="clean-label-mobile-slider">
        {% for block in section.blocks %}
          <article class="clean-label-mobile-slide" data-slide-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <div class="clean-label-mobile-image-wrap">
              {% if block.settings.image != blank %}
                {{
                  block.settings.image
                  | image_url: width: 700
                  | image_tag:
                    loading: 'lazy',
                    class: 'clean-label-mobile-image',
                    alt: block.settings.title
                }}
              {% else %}
                <div class="clean-label-placeholder">
                  {{ 'image' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p>{{ block.settings.text }}</p>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="clean-label-dots">
          {% for block in section.blocks %}
            <button
              class="clean-label-dot {% if forloop.first %}is-active{% endif %}"
              type="button"
              aria-label="Aller à la slide {{ forloop.index }}"
              data-dot-index="{{ forloop.index0 }}"
            ></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Manrope:wght@400;500;600;700;800&display=swap');

  #clean-label-{{ section.id }} {
    background: var(--bg-color);
    padding:
      var(--padding-top-desktop)
      var(--padding-right-desktop)
      var(--padding-bottom-desktop)
      var(--padding-left-desktop);
    overflow: hidden;
  }

  #clean-label-{{ section.id }} * {
    box-sizing: border-box;
  }

  #clean-label-{{ section.id }} .clean-label-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(240px, {{ section.settings.title_column_width }}px) minmax(0, 1fr);
    align-items: center;
    gap: {{ section.settings.desktop_main_gap }}px;
  }

  #clean-label-{{ section.id }} .clean-label-main-title {
    margin: 0;
    color: var(--title-color);
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.title_size_desktop }}px;
    line-height: 1.06;
    font-weight: {{ section.settings.title_weight }};
    letter-spacing: -0.06em;
  }

  #clean-label-{{ section.id }} .clean-label-desktop {
    display: grid;
    grid-template-columns: auto minmax(300px, {{ section.settings.card_column_width }}px);
    align-items: center;
    gap: {{ section.settings.desktop_content_gap }}px;
  }

  #clean-label-{{ section.id }} .clean-label-images {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.image_gap_desktop }}px;
    align-items: center;
  }

  #clean-label-{{ section.id }} .clean-label-image-item {
    width: var(--image-size-desktop);
    height: var(--image-size-desktop);
    border-radius: 50%;
    overflow: hidden;
    background: #f2f2f2;
    flex-shrink: 0;
  }

  #clean-label-{{ section.id }} .clean-label-image,
  #clean-label-{{ section.id }} .clean-label-placeholder svg {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }

  #clean-label-{{ section.id }} .clean-label-cards {
    display: flex;
    flex-direction: column;
    gap: {{ section.settings.card_gap_desktop }}px;
  }

  #clean-label-{{ section.id }} .clean-label-card {
    position: relative;
    min-height: {{ section.settings.card_min_height }}px;
    padding:
      {{ section.settings.card_padding_y }}px
      {{ section.settings.card_padding_x }}px;
    border: 1px solid var(--card-border);
    border-radius: {{ section.settings.card_radius }}px;
    background: var(--card-bg);
  }

  #clean-label-{{ section.id }} .clean-label-line {
    position: absolute;
    top: 50%;
    right: 100%;
    width: {{ section.settings.line_width_desktop }}px;
    height: 1px;
    background: var(--line-color);
    transform: translateY(-50%);
  }

  #clean-label-{{ section.id }} .clean-label-card h3 {
    margin: 0 0 {{ section.settings.card_title_margin_bottom }}px;
    color: var(--title-color);
    font-family: 'Manrope', sans-serif;
    font-size: {{ section.settings.card_title_size_desktop }}px;
    line-height: 1.15;
    font-weight: {{ section.settings.card_title_weight }};
    letter-spacing: -0.05em;
  }

  #clean-label-{{ section.id }} .clean-label-card p {
    margin: 0;
    color: var(--text-color);
    font-family: 'DM Sans', sans-serif;
    font-size: {{ section.settings.card_text_size_desktop }}px;
    line-height: 1.35;
    font-weight: {{ section.settings.card_text_weight }};
    letter-spacing: -0.015em;
  }

  #clean-label-{{ section.id }} .clean-label-mobile {
    display: none;
  }

  @media screen and (max-width: 989px) {
    #clean-label-{{ section.id }} .clean-label-inner {
      grid-template-columns: 1fr;
      gap: {{ section.settings.tablet_gap }}px;
    }

    #clean-label-{{ section.id }} .clean-label-title-wrap {
      text-align: center;
    }

    #clean-label-{{ section.id }} .clean-label-desktop {
      grid-template-columns: auto minmax(280px, 1fr);
      justify-content: center;
    }
  }

  @media screen and (max-width: 749px) {
    #clean-label-{{ section.id }} {
      padding:
        var(--padding-top-mobile)
        var(--padding-right-mobile)
        var(--padding-bottom-mobile)
        var(--padding-left-mobile);
    }

    #clean-label-{{ section.id }} .clean-label-inner {
      display: block;
      max-width: 100%;
    }

    #clean-label-{{ section.id }} .clean-label-title-wrap {
      text-align: {{ section.settings.title_align_mobile }};
      margin-bottom: {{ section.settings.title_margin_bottom_mobile }}px;
    }

    #clean-label-{{ section.id }} .clean-label-main-title {
      font-size: {{ section.settings.title_size_mobile }}px;
      line-height: 1.08;
    }

    #clean-label-{{ section.id }} .clean-label-desktop {
      display: none;
    }

    #clean-label-{{ section.id }} .clean-label-mobile {
      display: block;
    }

    #clean-label-{{ section.id }} .clean-label-mobile-slider {
      display: flex;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    #clean-label-{{ section.id }} .clean-label-mobile-slider::-webkit-scrollbar {
      display: none;
    }

    #clean-label-{{ section.id }} .clean-label-mobile-slide {
      flex: 0 0 100%;
      width: 100%;
      scroll-snap-align: center;
      text-align: center;
      padding: 0 {{ section.settings.mobile_slide_side_padding }}px;
    }

    #clean-label-{{ section.id }} .clean-label-mobile-image-wrap {
      width: var(--image-size-mobile);
      height: var(--image-size-mobile);
      margin: 0 auto {{ section.settings.mobile_image_margin_bottom }}px;
      border-radius: 50%;
      overflow: hidden;
      background: #f2f2f2;
    }

    #clean-label-{{ section.id }} .clean-label-mobile-image {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    #clean-label-{{ section.id }} .clean-label-mobile-slide h3 {
      margin: 0 0 {{ section.settings.mobile_title_margin_bottom }}px;
      color: var(--title-color);
      font-family: 'Manrope', sans-serif;
      font-size: {{ section.settings.card_title_size_mobile }}px;
      line-height: 1.15;
      font-weight: {{ section.settings.card_title_weight }};
      letter-spacing: -0.055em;
    }

    #clean-label-{{ section.id }} .clean-label-mobile-slide p {
      max-width: {{ section.settings.mobile_text_max_width }}px;
      margin: 0 auto;
      color: var(--text-color);
      font-family: 'DM Sans', sans-serif;
      font-size: {{ section.settings.card_text_size_mobile }}px;
      line-height: 1.35;
      font-weight: {{ section.settings.card_text_weight }};
      letter-spacing: -0.015em;
    }

    #clean-label-{{ section.id }} .clean-label-dots {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: {{ section.settings.dot_gap }}px;
      margin-top: {{ section.settings.dots_margin_top }}px;
    }

    #clean-label-{{ section.id }} .clean-label-dot {
      width: {{ section.settings.dot_size }}px;
      height: {{ section.settings.dot_size }}px;
      padding: 0;
      border: 0;
      border-radius: 50%;
      background: var(--dot-color);
      cursor: pointer;
      opacity: 1;
    }

    #clean-label-{{ section.id }} .clean-label-dot.is-active {
      background: var(--dot-active-color);
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#clean-label-{{ section.id }}');
    if (!section) return;

    const slider = section.querySelector('.clean-label-mobile-slider');
    const dots = section.querySelectorAll('.clean-label-dot');

    if (!slider || !dots.length) return;

    function setActiveDot(index) {
      dots.forEach(function (dot) {
        dot.classList.remove('is-active');
      });

      if (dots[index]) {
        dots[index].classList.add('is-active');
      }
    }

    dots.forEach(function (dot) {
      dot.addEventListener('click', function () {
        const index = Number(dot.dataset.dotIndex);
        const width = slider.clientWidth;

        slider.scrollTo({
          left: width * index,
          behavior: 'smooth'
        });

        setActiveDot(index);
      });
    });

    slider.addEventListener('scroll', function () {
      const index = Math.round(slider.scrollLeft / slider.clientWidth);
      setActiveDot(index);
    });
  });
</script>

{% schema %}
