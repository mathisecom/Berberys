{% liquid
  assign s = section.settings
%}

<section
  id="reviews-custom-{{ section.id }}"
  class="reviews-custom-section"
  style="
    --section-bg: {{ s.section_bg }};
    --title-color: {{ s.title_color }};
    --text-color: {{ s.text_color }};
    --muted-color: {{ s.muted_color }};
    --card-bg: {{ s.card_bg }};
    --card-border: {{ s.card_border }};
    --shadow-color: {{ s.shadow_color }};
    --star-color: {{ s.star_color }};
    --verified-color: {{ s.verified_color }};
    --button-bg: {{ s.button_bg }};
    --button-text: {{ s.button_text_color }};
    --arrow-bg: {{ s.arrow_bg }};
    --arrow-color: {{ s.arrow_color }};
    --font-family: {{ s.font_family }};
  "
>
  <div class="reviews-custom-wrapper">

    <div class="reviews-custom-header">
      {% if s.heading != blank %}
        <h2>{{ s.heading }}</h2>
      {% endif %}

      {% if s.rating_title != blank %}
        <div class="reviews-rating-line">
          <strong>{{ s.rating_title }}</strong>

          <span class="reviews-mini-stars" aria-label="Note 5 étoiles">
            {% for i in (1..5) %}
              <span>★</span>
            {% endfor %}
          </span>
        </div>
      {% endif %}

      {% if s.rating_text != blank %}
        <div class="reviews-rating-text">
          {{ s.rating_text }}
        </div>
      {% endif %}
    </div>

    <div class="reviews-slider-area">
      {% if s.show_arrows %}
        <button class="reviews-arrow reviews-arrow-prev" type="button" aria-label="Avis précédent">
          ‹
        </button>
      {% endif %}

      <div class="reviews-slider" data-reviews-slider>
        {% for block in section.blocks %}
          <article class="reviews-card" {{ block.shopify_attributes }}>
            {% if block.settings.review_image != blank %}
              <div class="reviews-image-wrap">
                <img
                  src="{{ block.settings.review_image | image_url: width: 900 }}"
                  alt="{{ block.settings.image_alt | escape }}"
                  loading="lazy"
                >
              </div>
            {% endif %}

            <div class="reviews-stars">
              {% for i in (1..5) %}
                <span>★</span>
              {% endfor %}
            </div>

            {% if block.settings.title != blank %}
              <h3>{{ block.settings.title }}</h3>
            {% endif %}

            {% if block.settings.text != blank %}
              <p class="reviews-text">
                {{ block.settings.text }}
              </p>
            {% endif %}

            {% if block.settings.author != blank %}
              <p class="reviews-author">
                - {{ block.settings.author }}
              </p>
            {% endif %}

            {% if block.settings.verified_text != blank %}
              <div class="reviews-verified">
                <span class="reviews-verified-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 6L9 17l-5-5"></path>
                  </svg>
                </span>
                <span>{{ block.settings.verified_text }}</span>
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>

      {% if s.show_arrows %}
        <button class="reviews-arrow reviews-arrow-next" type="button" aria-label="Avis suivant">
          ›
        </button>
      {% endif %}
    </div>

    {% if s.show_dots %}
      <div class="reviews-dots" data-reviews-dots></div>
    {% endif %}

    {% if s.show_button %}
      <div class="reviews-button-wrapper">
        <a href="{{ s.button_link }}" class="reviews-button">
          {{ s.button_label }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

<style>
  #reviews-custom-{{ section.id }} {
    background: var(--section-bg);
    padding: {{ s.padding_top }}px 20px {{ s.padding_bottom }}px;
    font-family: var(--font-family);
    overflow: hidden;
  }

  #reviews-custom-{{ section.id }} .reviews-custom-wrapper {
    max-width: {{ s.max_width }}px;
    margin: 0 auto;
  }

  #reviews-custom-{{ section.id }} .reviews-custom-header {
    text-align: center;
    margin-bottom: {{ s.header_bottom_spacing }}px;
  }

  #reviews-custom-{{ section.id }} .reviews-custom-header h2 {
    margin: 0;
    color: var(--title-color);
    font-size: {{ s.title_size }}px;
    font-weight: {{ s.title_weight }};
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  #reviews-custom-{{ section.id }} .reviews-rating-line {
    margin-top: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    color: var(--text-color);
    font-size: {{ s.rating_title_size }}px;
    line-height: 1;
  }

  #reviews-custom-{{ section.id }} .reviews-mini-stars {
    display: inline-flex;
    gap: 2px;
  }

  #reviews-custom-{{ section.id }} .reviews-mini-stars span {
    width: 17px;
    height: 17px;
    background: var(--star-color);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    line-height: 1;
  }

  #reviews-custom-{{ section.id }} .reviews-rating-text {
    margin-top: 14px;
    color: var(--text-color);
    font-size: {{ s.rating_text_size }}px;
    font-weight: 600;
    line-height: 1.4;
  }

  #reviews-custom-{{ section.id }} .reviews-slider-area {
    position: relative;
    max-width: {{ s.cards_area_width }}px;
    margin: 0 auto;
  }

  #reviews-custom-{{ section.id }} .reviews-slider {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - {{ s.card_gap | times: 2 }}px) / 3);
    gap: {{ s.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 0 4px 10px;
  }

  #reviews-custom-{{ section.id }} .reviews-slider::-webkit-scrollbar {
    display: none;
  }

  #reviews-custom-{{ section.id }} .reviews-card {
    scroll-snap-align: center;
    background: var(--card-bg);
    border: 1.5px solid var(--card-border);
    border-radius: {{ s.card_radius }}px;
    min-height: {{ s.card_min_height }}px;
    padding: {{ s.card_padding_top }}px {{ s.card_padding_horizontal }}px {{ s.card_padding_bottom }}px;
    color: var(--text-color);
    text-align: center;
    box-shadow: {{ s.shadow_offset }}px {{ s.shadow_offset }}px 0 var(--shadow-color);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  #reviews-custom-{{ section.id }} .reviews-image-wrap {
    width: 100%;
    margin: 0 0 20px;
    border-radius: {{ s.image_radius }}px;
    overflow: hidden;
    background: #f6f6f6;
  }

  #reviews-custom-{{ section.id }} .reviews-image-wrap img {
    width: 100%;
    aspect-ratio: {{ s.image_aspect_ratio }};
    object-fit: cover;
    display: block;
  }

  #reviews-custom-{{ section.id }} .reviews-stars {
    display: flex;
    justify-content: center;
    gap: 6px;
    color: var(--star-color);
    font-size: {{ s.stars_size }}px;
    line-height: 1;
    margin-bottom: 16px;
  }

  #reviews-custom-{{ section.id }} .reviews-card h3 {
    margin: 0 0 16px;
    color: var(--title-color);
    font-size: {{ s.card_title_size }}px;
    font-weight: 800;
    line-height: 1.2;
  }

  #reviews-custom-{{ section.id }} .reviews-text {
    margin: 0;
    color: var(--text-color);
    font-size: {{ s.card_text_size }}px;
    font-weight: 400;
    line-height: 1.12;
    max-width: 92%;
  }

  #reviews-custom-{{ section.id }} .reviews-author {
    margin: 24px 0 0;
    color: var(--text-color);
    font-size: {{ s.author_size }}px;
    font-weight: 800;
    line-height: 1.2;
  }

  #reviews-custom-{{ section.id }} .reviews-verified {
    margin-top: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 1.5px solid var(--card-border);
    border-radius: 999px;
    padding: 9px 18px;
    color: var(--text-color);
    font-size: {{ s.verified_size }}px;
    line-height: 1;
  }

  #reviews-custom-{{ section.id }} .reviews-verified-icon {
    width: 17px;
    height: 17px;
    border-radius: 999px;
    background: var(--verified-color);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  #reviews-custom-{{ section.id }} .reviews-verified-icon svg {
    width: 11px;
    height: 11px;
    stroke: currentColor;
  }

  #reviews-custom-{{ section.id }} .reviews-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 3;
    width: {{ s.arrow_size }}px;
    height: {{ s.arrow_size }}px;
    border-radius: 999px;
    border: none;
    background: var(--arrow-bg);
    color: var(--arrow-color);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: {{ s.arrow_icon_size }}px;
    line-height: 1;
    cursor: pointer;
    transition: transform .2s ease, opacity .2s ease;
  }

  #reviews-custom-{{ section.id }} .reviews-arrow:hover {
    transform: translateY(-50%) scale(1.06);
    opacity: .9;
  }

  #reviews-custom-{{ section.id }} .reviews-arrow-prev {
    left: -62px;
  }

  #reviews-custom-{{ section.id }} .reviews-arrow-next {
    right: -62px;
  }

  #reviews-custom-{{ section.id }} .reviews-dots {
    margin-top: 28px;
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  #reviews-custom-{{ section.id }} .reviews-dot {
    width: 9px;
    height: 9px;
    border-radius: 999px;
    border: 1.5px solid #111111;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }

  #reviews-custom-{{ section.id }} .reviews-dot.is-active {
    background: #111111;
  }

  #reviews-custom-{{ section.id }} .reviews-button-wrapper {
    display: flex;
    justify-content: center;
    margin-top: 34px;
  }

  #reviews-custom-{{ section.id }} .reviews-button {
    min-height: 52px;
    padding: 0 34px;
    border-radius: 999px;
    background: var(--button-bg);
    color: var(--button-text);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    font-weight: 900;
    text-transform: uppercase;
    box-shadow: 0 8px 18px rgba(0,0,0,.12);
    transition: transform .2s ease, opacity .2s ease;
  }

  #reviews-custom-{{ section.id }} .reviews-button:hover {
    transform: translateY(-2px);
    opacity: .92;
  }

  @media screen and (max-width: 989px) {
    #reviews-custom-{{ section.id }} .reviews-slider {
      grid-auto-columns: calc((100% - {{ s.card_gap }}px) / 2);
    }

    #reviews-custom-{{ section.id }} .reviews-arrow-prev {
      left: -14px;
    }

    #reviews-custom-{{ section.id }} .reviews-arrow-next {
      right: -14px;
    }
  }

  @media screen and (max-width: 749px) {
    #reviews-custom-{{ section.id }} {
      padding: {{ s.mobile_padding_top }}px 18px {{ s.mobile_padding_bottom }}px;
    }

    #reviews-custom-{{ section.id }} .reviews-custom-header h2 {
      font-size: {{ s.mobile_title_size }}px;
    }

    #reviews-custom-{{ section.id }} .reviews-rating-line {
      flex-wrap: wrap;
      margin-top: 16px;
      font-size: {{ s.mobile_rating_title_size }}px;
    }

    #reviews-custom-{{ section.id }} .reviews-rating-text {
      font-size: {{ s.mobile_rating_text_size }}px;
    }

    #reviews-custom-{{ section.id }} .reviews-slider {
      grid-auto-columns: 86%;
      gap: 18px;
      padding-left: 4px;
      padding-right: 4px;
    }

    #reviews-custom-{{ section.id }} .reviews-card {
      min-height: {{ s.mobile_card_min_height }}px;
      padding: {{ s.mobile_card_padding_top }}px {{ s.mobile_card_padding_horizontal }}px {{ s.mobile_card_padding_bottom }}px;
    }

    #reviews-custom-{{ section.id }} .reviews-card h3 {
      font-size: {{ s.mobile_card_title_size }}px;
    }

    #reviews-custom-{{ section.id }} .reviews-text {
      font-size: {{ s.mobile_card_text_size }}px;
      line-height: 1.18;
    }

    #reviews-custom-{{ section.id }} .reviews-stars {
      font-size: {{ s.mobile_stars_size }}px;
    }

    #reviews-custom-{{ section.id }} .reviews-arrow {
      width: 36px;
      height: 36px;
      font-size: 28px;
    }

    #reviews-custom-{{ section.id }} .reviews-arrow-prev {
      left: -6px;
    }

    #reviews-custom-{{ section.id }} .reviews-arrow-next {
      right: -6px;
    }

    #reviews-custom-{{ section.id }} .reviews-button {
      width: 100%;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const section = document.querySelector('#reviews-custom-{{ section.id }}');
    if (!section) return;

    const slider = section.querySelector('[data-reviews-slider]');
    const dotsContainer = section.querySelector('[data-reviews-dots]');
    const prev = section.querySelector('.reviews-arrow-prev');
    const next = section.querySelector('.reviews-arrow-next');

    if (!slider) return;

    const cards = Array.from(slider.querySelectorAll('.reviews-card'));

    function getStep() {
      const card = cards[0];
      if (!card) return 300;
      const styles = window.getComputedStyle(slider);
      const gap = parseFloat(styles.columnGap || styles.gap || 0);
      return card.getBoundingClientRect().width + gap;
    }

    function getActiveIndex() {
      const step = getStep();
      return Math.round(slider.scrollLeft / step);
    }

    function updateDots() {
      if (!dotsContainer) return;
      const activeIndex = getActiveIndex();
      const dots = Array.from(dotsContainer.querySelectorAll('.reviews-dot'));
      dots.forEach(function(dot, index) {
        dot.classList.toggle('is-active', index === activeIndex);
      });
    }

    if (dotsContainer && cards.length > 0) {
      dotsContainer.innerHTML = '';
      cards.forEach(function(_, index) {
        const dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'reviews-dot';
        dot.setAttribute('aria-label', 'Aller à l’avis ' + (index + 1));
        dot.addEventListener('click', function() {
          slider.scrollTo({
            left: getStep() * index,
            behavior: 'smooth'
          });
        });
        dotsContainer.appendChild(dot);
      });
      updateDots();
    }

    if (prev) {
      prev.addEventListener('click', function() {
        slider.scrollBy({
          left: -getStep(),
          behavior: 'smooth'
        });
      });
    }

    if (next) {
      next.addEventListener('click', function() {
        slider.scrollBy({
          left: getStep(),
          behavior: 'smooth'
        });
      });
    }

    slider.addEventListener('scroll', function() {
      window.requestAnimationFrame(updateDots);
    });

    window.addEventListener('resize', updateDots);
  });
</script>

{% schema %}
{
  "name": "Avis clients custom",
  "settings": [
    {
      "type": "header",
      "content": "Textes principaux"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Titre",
      "default": "Ce que nos clients en disent vraiment"
    },
    {
      "type": "text",
      "id": "rating_title",
      "label": "Texte note",
      "default": "Excellent"
    },
    {
      "type": "richtext",
      "id": "rating_text",
      "label": "Texte sous note",
      "default": "<p>4.9/5 sur <strong>16,900+ avis</strong> sur Trustpilot</p>"
    },
    {
      "type": "header",
      "content": "Bouton optionnel"
    },
    {
      "type": "checkbox",
      "id": "show_button",
      "label": "Afficher le bouton",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texte bouton",
      "default": "Voir les avis"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Lien bouton"
    },
    {
      "type": "header",
      "content": "Couleurs"
    },
    {
      "type": "color",
      "id": "section_bg",
      "label": "Fond section",
      "default": "#FEF9F0"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Fond cartes",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "card_border",
      "label": "Bordure cartes",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "shadow_color",
      "label": "Ombre cartes",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "title_color",
      "label": "Couleur titres",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Couleur textes",
      "default": "#222222"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Couleur texte secondaire",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "star_color",
      "label": "Couleur étoiles",
      "default": "#00B67A"
    },
    {
      "type": "color",
      "id": "verified_color",
      "label": "Couleur badge vérifié",
      "default": "#00B67A"
    },
    {
      "type": "color",
      "id": "button_bg",
      "label": "Fond bouton",
      "default": "#FFF27B"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Texte bouton",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "arrow_bg",
      "label": "Fond flèches",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "arrow_color",
      "label": "Couleur flèches",
      "default": "#FFFFFF"
    },
    {
      "type": "header",
      "content": "Typographie"
    },
    {
      "type": "select",
      "id": "font_family",
      "label": "Typographie",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Typographie du thème"
        },
        {
          "value": "Arial, sans-serif",
          "label": "Arial"
        },
        {
          "value": "Helvetica, Arial, sans-serif",
          "label": "Helvetica"
        },
        {
          "value": "Georgia, serif",
          "label": "Georgia"
        },
        {
          "value": "'Poppins', sans-serif",
          "label": "Poppins si installé"
        },
        {
          "value": "'Montserrat', sans-serif",
          "label": "Montserrat si installé"
        }
      ]
    },
    {
      "type": "range",
      "id": "title_size",
      "label": "Taille titre desktop",
      "min": 20,
      "max": 60,
      "step": 1,
      "default": 34
    },
    {
      "type": "range",
      "id": "mobile_title_size",
      "label": "Taille titre mobile",
      "min": 18,
      "max": 42,
      "step": 1,
      "default": 28
    },
    {
      "type": "select",
      "id": "title_weight",
      "label": "Graisse titre",
      "default": "800",
      "options": [
        { "value": "400", "label": "Normal" },
        { "value": "500", "label": "Medium" },
        { "value": "600", "label": "Semi-bold" },
        { "value": "700", "label": "Bold" },
        { "value": "800", "label": "Extra-bold" },
        { "value": "900", "label": "Black" }
      ]
    },
    {
      "type": "range",
      "id": "rating_title_size",
      "label": "Taille texte note desktop",
      "min": 12,
      "max": 28,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "mobile_rating_title_size",
      "label": "Taille texte note mobile",
      "min": 12,
      "max": 24,
      "step": 1,
      "default": 16
    },
    {
      "type": "range",
      "id": "rating_text_size",
      "label": "Taille sous-note desktop",
      "min": 11,
      "max": 24,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_rating_text_size",
      "label": "Taille sous-note mobile",
      "min": 11,
      "max": 22,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "card_title_size",
      "label": "Taille titre avis desktop",
      "min": 14,
      "max": 30,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "mobile_card_title_size",
      "label": "Taille titre avis mobile",
      "min": 14,
      "max": 28,
      "step": 1,
      "default": 19
    },
    {
      "type": "range",
      "id": "card_text_size",
      "label": "Taille texte avis desktop",
      "min": 11,
      "max": 22,
      "step": 1,
      "default": 15
    },
    {
      "type": "range",
      "id": "mobile_card_text_size",
      "label": "Taille texte avis mobile",
      "min": 11,
      "max": 22,
      "step": 1,
      "default": 14
    },
    {
      "type": "range",
      "id": "author_size",
      "label": "Taille auteur",
      "min": 10,
      "max": 20,
      "step": 1,
      "default": 12
    },
    {
      "type": "range",
      "id": "verified_size",
      "label": "Taille acheteur vérifié",
      "min": 10,
      "max": 18,
      "step": 1,
      "default": 13
    },
    {
      "type": "header",
      "content": "Cartes avis"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Largeur section",
      "min": 900,
      "max": 1800,
      "step": 20,
      "default": 1280
    },
    {
      "type": "range",
      "id": "cards_area_width",
      "label": "Largeur zone cartes",
      "min": 800,
      "max": 1500,
      "step": 20,
      "default": 1040
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Espace entre cartes",
      "min": 12,
      "max": 50,
      "step": 2,
      "default": 28
