        "ggWqntl2OWt_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/0997/4064/7801/files/POP_23_1_498f61a5-95fc-4504-bc03-d20b4b085c84.png",
        "ggWqntl2OWt_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/0997/4064/7801/files/POP_23_1_498f61a5-95fc-4504-bc03-d20b4b085c84.png",
